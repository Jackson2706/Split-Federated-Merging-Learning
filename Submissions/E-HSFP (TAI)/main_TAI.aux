\@writefile{lot}{\contentsline {table}{\numberline {V}{\ignorespaces Architecture, client-count, and temperature sensitivity (\%, reported mean $\pm $ standard deviation). The intended protocol uses 200 rounds, five runs, 200 clients, and $T_{\mathrm  {temp}}=0.5$ unless varied; resolved per-seed 200-round E-HSFP\xspace  {} records were not recovered. The $T_{\mathrm  {temp}}=0.5$ H-SFP cells are reproduced from the published ECCV temperature table~\cite  {tran2026h}. {\color  {reviewpurple}The E-HSFP\xspace  {} IID entries remain as reported manuscript aggregates because they agree with Figure~\ref {fig:partition_accuracy}; the three $\mathrm  {Dir}(0.7)$ entries are unavailable because the table and figure disagree and neither source has recoverable five-seed provenance.} Client-count sweeps use IID data. R50 denotes ResNet-50, and HAM denotes HAM10000.}}{14}{table.97}\protected@file@percent }
\newlabel{tab:sweep_200}{{V}{14}{Architecture, client-count, and temperature sensitivity (\%, reported mean $\pm $ standard deviation). The intended protocol uses 200 rounds, five runs, 200 clients, and $T_{\mathrm {temp}}=0.5$ unless varied; resolved per-seed 200-round \ehsfp {} records were not recovered. The $T_{\mathrm {temp}}=0.5$ H-SFP cells are reproduced from the published ECCV temperature table~\cite {tran2026h}. \reviewpurple {The \ehsfp {} IID entries remain as reported manuscript aggregates because they agree with Figure~\ref {fig:partition_accuracy}; the three $\mathrm {Dir}(0.7)$ entries are unavailable because the table and figure disagree and neither source has recoverable five-seed provenance.} Client-count sweeps use IID data. R50 denotes ResNet-50, and HAM denotes HAM10000}{table.97}{}}
