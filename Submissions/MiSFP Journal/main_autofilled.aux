\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces Empirical results generated from the central long-format result file (validated runs only; CIFAR-100, Dir($\alpha {=}0.1$)). (a) Validation accuracy versus cumulative communication; (b) validation accuracy versus communication round; (c) sliced Wasserstein distance between synthetic and real training features in a PCA projection fit on real features, single Gaussian versus mixture; (d) edge-to-cloud components per class versus final-round test accuracy, including the matched-budget variants. Lines and bars show seed means; bands and error bars are $\pm 1$ sample SD when at least two seeds are complete; $n$ gives the completed seeds per series. Panels without a completed run are marked results pending.}}{7}{figure.caption.12}\protected@file@percent }
\newlabel{fig:empirical}{{4}{7}{Empirical results generated from the central long-format result file (validated runs only; CIFAR-100, Dir($\alpha {=}0.1$)). (a) Validation accuracy versus cumulative communication; (b) validation accuracy versus communication round; (c) sliced Wasserstein distance between synthetic and real training features in a PCA projection fit on real features, single Gaussian versus mixture; (d) edge-to-cloud components per class versus final-round test accuracy, including the matched-budget variants. Lines and bars show seed means; bands and error bars are $\pm 1$ sample SD when at least two seeds are complete; $n$ gives the completed seeds per series. Panels without a completed run are marked results pending}{figure.caption.12}{}}
\newlabel{fig:empirical@cref}{{[figure][4][]4}{[1][5][]7}}
