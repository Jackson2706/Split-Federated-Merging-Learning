\def\@LN@column{1}
\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces Communication overhead analysis on CIFAR-100 over $200$ rounds. \textbf  {(Left)} Total communication cost across all methods plotted on a logarithmic scale. H-SFP (ours) reduces the total overhead by over $350$$\times $ compared to standard FedAvg. \textbf  {(Right)} A detailed breakdown of the communication components for the split-learning baselines. H-SFP's extreme efficiency stems from replacing high-dimensional smashed data with lightweight statistics and eliminating the need to transmit gradients.}}{13}{figure.caption.8}\protected@file@percent }
\newlabel{fig:comm_overhead}{{4}{13}{Communication overhead analysis on CIFAR-100 over $200$ rounds. \textbf {(Left)} Total communication cost across all methods plotted on a logarithmic scale. H-SFP (ours) reduces the total overhead by over $350$$\times $ compared to standard FedAvg. \textbf {(Right)} A detailed breakdown of the communication components for the split-learning baselines. H-SFP's extreme efficiency stems from replacing high-dimensional smashed data with lightweight statistics and eliminating the need to transmit gradients}{figure.caption.8}{}}
\newlabel{fig:comm_overhead@cref}{{[figure][4][]4}{[1][11][]13}{}{}{}}
\@writefile{lot}{\contentsline {table}{\numberline {4}{\ignorespaces Accuracy (\%) on CIFAR-100 and ImageNet-1K under the IID scenario with varying client cohort sizes. Results are averaged over 5 independent runs (mean $\pm $ std). (A), (B), and (C) represent client-edge and edge-cloud aggregation intervals. \textbf  {Bold} indicates the best federated performance, and \underline  {underline} indicates the second-best.}}{13}{table.caption.9}\protected@file@percent }
\newlabel{tab:main_robustness_sparsity}{{4}{13}{Accuracy (\%) on CIFAR-100 and ImageNet-1K under the IID scenario with varying client cohort sizes. Results are averaged over 5 independent runs (mean $\pm $ std). (A), (B), and (C) represent client-edge and edge-cloud aggregation intervals. \textbf {Bold} indicates the best federated performance, and \underline {underline} indicates the second-best}{table.caption.9}{}}
\newlabel{tab:main_robustness_sparsity@cref}{{[table][4][]4}{[1][12][]13}{}{}{}}
\def\@LN@column{1}
\@writefile{lot}{\contentsline {table}{\numberline {5}{\ignorespaces Ablation study on the components of H-SFP, reporting Accuracy (\%) at client-edge interval $I_c=5$ and edge-cloud interval $I_e=10$ across $200$ distributed devices. The results show the incremental performance gains achieved by adding a contrastive loss and synthetic data. We validate our core design choices by comparing the \textbf  {Full H-SFP} against two key ablations: a \textbf  {Full ($\mu $-only)} variant (lacking dimension-aware variance) and a \textbf  {Full (Purely Generative)} variant without averaging.}}{14}{table.caption.10}\protected@file@percent }
\newlabel{tab:ablation}{{5}{14}{Ablation study on the components of H-SFP, reporting Accuracy (\%) at client-edge interval $I_c=5$ and edge-cloud interval $I_e=10$ across $200$ distributed devices. The results show the incremental performance gains achieved by adding a contrastive loss and synthetic data. We validate our core design choices by comparing the \textbf {Full H-SFP} against two key ablations: a \textbf {Full ($\mu $-only)} variant (lacking dimension-aware variance) and a \textbf {Full (Purely Generative)} variant without averaging}{table.caption.10}{}}
\newlabel{tab:ablation@cref}{{[table][5][]5}{[1][14][]14}{}{}{}}
\@writefile{lot}{\contentsline {table}{\numberline {6}{\ignorespaces Ablation on the temperature hyperparameter $\tau $ of H-SFP. Results show the Accuracy (\%) at client-edge interval $I_c=5$ and edge-cloud interval $I_e=10$. Results are averaged over 5 independent runs (mean $\pm $ std). The optimal performance is consistently achieved at $\tau =0.5$.}}{14}{table.caption.11}\protected@file@percent }
\newlabel{tab:temp_ablation}{{6}{14}{Ablation on the temperature hyperparameter $\tau $ of H-SFP. Results show the Accuracy (\%) at client-edge interval $I_c=5$ and edge-cloud interval $I_e=10$. Results are averaged over 5 independent runs (mean $\pm $ std). The optimal performance is consistently achieved at $\tau =0.5$}{table.caption.11}{}}
\newlabel{tab:temp_ablation@cref}{{[table][6][]6}{[1][14][]14}{}{}{}}
