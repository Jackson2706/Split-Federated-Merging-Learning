     6	class DiceFocalLoss(nn.Module):
     7	    def __init__(
     8	        self, alpha=0.25, gamma=2.0, smooth=1.0, eps=1e-7, debug=False
     9	    ):
    10	        super(DiceFocalLoss, self).__init__()
    11	        self.alpha = alpha
    12	        self.gamma = gamma
    13	        self.smooth = smooth
    14	        self.eps = eps
    15	        self.debug = debug
    16	
    17	    def _sanity_check(self, preds, targets):
    18	        if preds.dim() == 3:
    19	            preds = preds.unsqueeze(1)
    20	        if targets.dim() == 3:
    21	            targets = targets.unsqueeze(1)
    22	
    23	        if preds.shape != targets.shape:
    24	            raise ValueError(
    25	                f"[DiceFocalLoss] Shape mismatch: preds {preds.shape}, targets {targets.shape}"
    26	            )
    27	
    28	        # Invalid values cannot be made finite by clamp alone. Map them to the
    29	        # nearest valid binary value, then keep probabilities away from log(0).
    30	        preds = torch.nan_to_num(preds, nan=0.0, posinf=1.0, neginf=0.0)
    31	        targets = torch.nan_to_num(targets, nan=0.0, posinf=1.0, neginf=0.0)
    32	        preds = preds.clamp(min=self.eps, max=1.0 - self.eps)
    33	        targets = targets.clamp(min=0.0, max=1.0)
    34	
    35	        return preds, targets
    36	
    37	    def dice_loss(self, preds, targets):
    38	        preds = preds.contiguous().view(-1)
    39	        targets = targets.contiguous().view(-1)
    40	
    41	        intersection = (preds * targets).sum()
    42	        union = preds.sum() + targets.sum()
    43	        dice = (2.0 * intersection + self.smooth + self.eps) / (
    44	            union + self.smooth + self.eps
    45	        )
    46	
    47	        return 1 - dice
    48	
    49	    def focal_loss(self, preds, targets):
    50	        preds = preds.contiguous().view(-1)
    51	        targets = targets.contiguous().view(-1)
    52	
    53	        if preds.numel() == 0:
    54	            return preds.sum()
    55	
    56	        preds = preds.clamp(min=self.eps, max=1.0 - self.eps)
    57	        bce = F.binary_cross_entropy(preds, targets, reduction="none")
    58	        pt = torch.exp(-bce)
    59	        focal = self.alpha * (1 - pt) ** self.gamma * bce
    60	        return focal.mean()
