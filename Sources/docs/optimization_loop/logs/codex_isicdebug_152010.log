     8	def compute_iou_and_dice(preds, labels):
     9	    # Convert tensors to numpy arrays
    10	    preds = preds.cpu().numpy()
    11	    labels = labels.cpu().numpy()
    12	
    13	    # Flatten arrays
    14	    preds = preds.flatten()
    15	    labels = labels.flatten()
    16	
    17	    # Convert to binary predictions (if needed)
    18	    preds_binary = (preds > 0.5).astype(np.int32)
    19	
    20	    # Compute Intersection and Union for IoU
    21	    intersection = np.sum((preds_binary == 1) & (labels == 1))
    22	    union = np.sum((preds_binary == 1) | (labels == 1))
    23	    iou = intersection / union if union != 0 else 0
    24	
    25	    # Compute Dice Coefficient
    26	    dice = (
    27	        2 * intersection / (np.sum(preds_binary == 1) + np.sum(labels == 1))
    28	        if (np.sum(preds_binary == 1) + np.sum(labels == 1)) != 0
    29	        else 0
    30	    )
    31	
    32	    return iou, dice
