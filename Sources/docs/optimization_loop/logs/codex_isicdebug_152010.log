        img = self.img_files[index]
        mask = self.mask_imgs[index]
        img = self.data_transforms(Image.open(img))
        mask = self.mask_transforms(Image.open(mask))

        return img, mask

    def __len__(self):
        assert self.datalen == len(self.mask_imgs)
        return self.datalen
