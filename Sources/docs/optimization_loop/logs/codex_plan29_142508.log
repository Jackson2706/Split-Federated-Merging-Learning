                        # Segmentation: use DiceFocalLoss for both, average
                        loss_wide = criterion(pred_wide, mask)
                        loss_narrow = criterion(pred_narrow, mask)
                        loss = loss_wide + 0.5 * loss_narrow
                        loss.backward()
                        activation_grad = act_wide.grad
                    else:
