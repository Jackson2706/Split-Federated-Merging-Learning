+    assert_finite(results)
+    result_path.write_text(json.dumps(results, indent=2, sort_keys=True) + "\n", encoding="utf-8")
+    write_markdown(output_dir / "NORMALIZE_SUMMARY.md", results)
+    print(f"wrote {result_path}")
+
