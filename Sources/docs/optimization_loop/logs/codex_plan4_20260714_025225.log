+        "mean_only_prototype_head_top1": mean_top1,
+        "diagonal_gaussian_prototype_head_top1": diag_top1,
+        "cosine_angular_margin_head_top1": cosine_top1,
+        "full_data_linear_probe_top1": linear_top1,
