+                f"{item['mean_centroid_pairwise_cosine']:.4f} | "
+                f"{item['within_between_scatter_ratio']:.4f} |"
+            )
+    lines += ["", "Unrounded metrics and leakage-audit metadata are in `normalize_results.json`.", ""]
