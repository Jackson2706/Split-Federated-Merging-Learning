python - <<'PY'
from pathlib import Path
import hashlib, json
import numpy as np
import yaml

root = Path('.')
seeds = (20260714, 20260715, 20260716)
configs = sorted((root / 'configs/proxy').glob('*isic*'))

def resolve(path):
    data = yaml.safe_load(path.read_text()) or {}
    base = data.pop('base', None)
    if base:
        parent = resolve((path.parent / base).resolve())
        parent.update(data)
        return parent
    return data

def phash(groups):
    normalized = {str(k): sorted(int(i) for i in v) for k, v in groups.items()}
    payload = json.dumps(normalized, sort_keys=True, separators=(',', ':'), allow_nan=False)
    return hashlib.sha256(payload.encode()).hexdigest()

resolved = {p.name: resolve(p) for p in configs}
required = ('train_image_data_folder_path','train_mask_data_folder_path','test_image_data_folder_path','test_mask_data_folder_path')
for name, cfg in resolved.items():
    counts=[]
    for key in required:
        path=root/cfg[key]
        suffix='.jpg' if 'image' in key else '.png'
        assert path.is_dir(), (name,key,path)
        counts.append(len(list(path.glob('*'+suffix))))
    assert counts == [2594,2594,100,100], (name,counts)
    assert cfg['num_users'] == 50 and cfg['epochs'] == 60
    print(name, counts)

for seed in seeds:
    np.random.seed(seed)
    n, users = 2594, 50
    num_items = n // users
    groups, all_idxs = {}, list(range(n))
    for i in range(users):
        groups[i] = set(np.random.choice(all_idxs, num_items, replace=False))
        all_idxs = list(set(all_idxs) - groups[i])
    digest = phash(groups)
    print(seed, digest, 'all_four_methods_match')
