# H-SFP / E-HSFP — common tasks. Run `make help` for the list.
.DEFAULT_GOAL := help
PY ?= python
HSFP_CFG := configs/classification/h-sfp/cifar_our_resnet50_5_10.yaml

.PHONY: help install install-cuda data-check check smoke \
        reproduce-journal reproduce-camera-ready fairness figures clean clean-pyc

help:  ## Show this help
	@grep -E '^[a-zA-Z0-9_-]+:.*?## .*$$' $(MAKEFILE_LIST) | \
		awk 'BEGIN{FS=":.*?## "}{printf "  \033[36m%-22s\033[0m %s\n", $$1, $$2}'

install:  ## Install Python dependencies (assumes torch already installed)
	$(PY) -m pip install -r requirements.txt

install-cuda:  ## Install a CUDA 12.8 torch build, then the rest
	$(PY) -m pip install torch torchvision --index-url https://download.pytorch.org/whl/cu128
	$(PY) -m pip install -r requirements.txt

data-check:  ## Verify the expected data/ layout exists (see docs/datasets.md)
	@for d in cifar HAM10000 ISIC2018; do \
		if [ -e data/$$d ]; then echo "ok   data/$$d"; else echo "MISS data/$$d (see docs/datasets.md)"; fi; \
	done

check:  ## Lightweight sanity checks (no training)
	$(PY) -m py_compile $$(git ls-files '*.py')
	$(PY) main.py --list >/dev/null && echo "registry OK"
	$(PY) -m camera_ready.partition >/dev/null && echo "partition self-test OK"

smoke:  ## One tiny end-to-end H-SFP run (fast sanity)
	$(PY) main.py --task classification --method h-sfp \
		--cfg configs/camera_ready/smoke/hsfp_smoke.yaml --seed 0

reproduce-journal:  ## Run the full E-HSFP journal suite
	bash scripts/journal_experiments/run_all_journal.sh
	$(PY) scripts/journal_experiments/collect_results.py

reproduce-camera-ready:  ## Run all camera-ready experiments (set SMOKE=1 for a fast pass)
	bash scripts/camera_ready/run_all_camera_ready.sh
	$(PY) scripts/camera_ready/collect_camera_ready.py
	$(PY) scripts/camera_ready/make_tables.py

fairness:  ## Generate the baseline-fairness summary + LaTeX
	$(PY) scripts/camera_ready/gen_fairness.py

figures:  ## Regenerate the communication-overhead figure
	$(PY) tools/plot_communication.py communication_overhead.png

clean-pyc:  ## Remove Python caches
	find . -type d -name __pycache__ -prune -exec rm -rf {} + 2>/dev/null || true

clean: clean-pyc  ## Remove caches and local run artifacts (keeps data/ and checkpoints)
	rm -rf logs/* 2>/dev/null || true
tests/test_phase0_effects.py
import json
import inspect
import tempfile
import unittest

import torch

from ehsfp import (
    ABLATION_PRESETS, EHSFP_DEFAULTS, EpisodicPrototypeMemory,
    PrototypeDropout, PrototypeRecord, PrototypeReliabilityNetwork,
    RuntimeCounters, build_reliability_features, get_ehsfp_config,
    mix_current_and_memory, prepare_run_dir,
    prototype_replay_consistency_loss, reliability_weighted_aggregate,
    resolved_config_hash, validate_checkpoint_config_hash,
)
from ehsfp import aggregation as aggregation_module
from ehsfp import losses as losses_module
from ehsfp import memory as memory_module
from ehsfp import reliability as reliability_module


def _prc_gradient(memory_mu):
    representation = torch.nn.Linear(2, 1, bias=False)
    representation.weight.data.copy_(torch.tensor([[1.0, -0.5]]))
    counters = RuntimeCounters()
    loss = prototype_replay_consistency_loss(
        {0: torch.tensor([1.0, 2.0])}, {0: torch.zeros(2)},
        {0: torch.tensor(memory_mu)}, {0: torch.zeros(2)},
        representation, num_samples=3, device=torch.device("cpu"),
        runtime_counters=counters,
    )
    loss.backward()
    return representation.weight.grad.clone(), loss.item(), counters.snapshot()


class Phase0EffectTests(unittest.TestCase):
    def test_memory_consumers_coerce_cpu_records_to_compute_device(self):
        # Resolve to an indexed device (e.g. cuda:0) so equality with a
        # tensor's .device holds on GPU hosts (torch.device('cuda') != 'cuda:0').
        target = torch.empty(0, device="cuda" if torch.cuda.is_available() else "cpu").device
        record = PrototypeRecord(
            0, torch.tensor([1.0, 2.0]), torch.tensor([0.2, 0.4]),
            3, "cpu-memory", 0,
        )
        center = torch.tensor([1.5, 2.5], device=target)

        features = build_reliability_features([record], center, device=target)
        self.assertEqual(features.device, target)

        memory = EpisodicPrototypeMemory(max_size=2, max_age=2)
tests/test_plan29_segmentation.py
import ast
import importlib.util
import unittest
from pathlib import Path

import torch
import torch.nn.functional as F

from segmentation.training_metrics import BestSegmentationMetrics


ROOT = Path(__file__).resolve().parents[1]
LOSS_PATHS = [
    ROOT / "segmentation" / method / "clients" / "DiceFocalLoss.py"
    for method in ("Federated", "HierFL", "HeteroSFL", "H-SFP")
]


def load_loss(path):
    spec = importlib.util.spec_from_file_location(f"plan29_loss_{path.parent.parent.name}", path)
    module = importlib.util.module_from_spec(spec)
    spec.loader.exec_module(module)
    return module.DiceFocalLoss


def load_alignment_helper():
    path = ROOT / "segmentation" / "HeteroSFL" / "runner.py"
    tree = ast.parse(path.read_text())
    function = next(
        node for node in tree.body
        if isinstance(node, ast.FunctionDef) and node.name == "align_prediction_to_mask"
    )
    namespace = {"F": F}
    exec(compile(ast.Module(body=[function], type_ignores=[]), str(path), "exec"), namespace)
    return namespace["align_prediction_to_mask"]


class Plan29SegmentationTests(unittest.TestCase):
    def test_foreground_weighting_increases_all_background_penalty(self):
        focal_functions = []
        for path in LOSS_PATHS:
            tree = ast.parse(path.read_text())
            loss_class = next(node for node in tree.body if isinstance(node, ast.ClassDef))
            focal_functions.append(next(
                node for node in loss_class.body
                if isinstance(node, ast.FunctionDef) and node.name == "focal_loss"
            ))
        focal_dumps = [ast.dump(node, include_attributes=False) for node in focal_functions]
        self.assertTrue(all(dump == focal_dumps[0] for dump in focal_dumps[1:]))

