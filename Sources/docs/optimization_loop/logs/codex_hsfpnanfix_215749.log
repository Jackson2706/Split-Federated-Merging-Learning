   215	def supervised_contrastive_loss(features, labels, temperature=0.5):
   216	    """
   217	    Supervised Contrastive Loss (SupCon) — Paper Eq. 1.
   218	    Positive pairs P(i) are samples sharing the same class label.
   219	    """
   220	    # Keep the inexpensive SupCon reduction in fp32.  In particular, its
   221	    # matmul/exp/log operations are not numerically safe under fp16 autocast.
   222	    with torch.autocast(device_type=features.device.type, enabled=False):
   223	        features = nn.functional.normalize(features.float(), dim=1)
   224	        batch_size = features.shape[0]
   225	        device = features.device
   226	
   227	        sim_matrix = torch.matmul(features, features.T) / temperature
   228	
   229	        labels_col = labels.view(-1, 1)
   230	        positive_mask = torch.eq(labels_col, labels_col.T).float()
   231	        self_mask = torch.eye(batch_size, device=device)
   232	        positive_mask = positive_mask - self_mask
   233	
   234	        logits_max, _ = sim_matrix.max(dim=1, keepdim=True)
   235	        logits = sim_matrix - logits_max.detach()
   236	
   237	        exp_logits = torch.exp(logits) * (1 - self_mask)
   238	        log_prob = logits - torch.log(exp_logits.sum(dim=1, keepdim=True) + 1e-8)
   239	
   240	        num_positives = positive_mask.sum(dim=1)
   241	        mean_log_prob = (positive_mask * log_prob).sum(dim=1) / (num_positives + 1e-8)
   242	
   243	        valid = (num_positives > 0).float()
   244	        loss = -(valid * mean_log_prob).sum() / (valid.sum() + 1e-8)
   245	
   246	        return loss
   247	
   248	# --- Class utility functions (HFL utils) ---
