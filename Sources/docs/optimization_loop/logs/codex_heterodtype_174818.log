import ast
import copy
import sys
import torch
from collections import OrderedDict
from pathlib import Path

root = Path('.')

# Load only aggregate_hetero so importing the training runner cannot trigger dataset dependencies.
source = (root / 'segmentation/HeteroSFL/runner.py').read_text()
tree = ast.parse(source)
func = next(node for node in tree.body if isinstance(node, ast.FunctionDef) and node.name == 'aggregate_hetero')
ns = {'copy': copy, 'torch': torch}
exec(compile(ast.Module(body=[func], type_ignores=[]), '<aggregate_hetero>', 'exec'), ns)
aggregate_hetero = ns['aggregate_hetero']

global_state = OrderedDict([
    ('bn.num_batches_tracked', torch.tensor(7, dtype=torch.long)),
    ('flag', torch.tensor(True, dtype=torch.bool)),
    ('head.weight', torch.tensor([2.0, 4.0])),
    ('head.bias', torch.tensor([1.0, 3.0])),
])
clients = [
    OrderedDict([
