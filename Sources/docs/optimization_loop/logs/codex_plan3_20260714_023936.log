for name,item in a['boundaries'].items():
 assert item['shape']['train'][1] == a['boundary_contract'][name]
 assert item['shape']['eval'][1] == a['boundary_contract'][name]
 assert set(item['downstream_head_top1_on_real_eval']) == {'real','mean_only','diagonal_gaussian','source_prototype_mixture'}
 def finite(x):
  if isinstance(x,dict): return all(finite(v) for v in x.values())
  if isinstance(x,list): return all(finite(v) for v in x)
  return not isinstance(x,float) or math.isfinite(x)
 assert finite(item)
 print(f\"{name}: train={item['shape']['train']} eval={item['shape']['eval']} finite=true\")
