    22	def _prc_gradient(memory_mu):
    23	    representation = torch.nn.Linear(2, 1, bias=False)
    24	    representation.weight.data.copy_(torch.tensor([[1.0, -0.5]]))
    25	    counters = RuntimeCounters()
    26	    loss = prototype_replay_consistency_loss(
    27	        {0: torch.tensor([1.0, 2.0])}, {0: torch.zeros(2)},
    28	        {0: torch.tensor(memory_mu)}, {0: torch.zeros(2)},
    29	        representation, num_samples=3, device=torch.device("cpu"),
    30	        runtime_counters=counters,
    31	    )
    32	    loss.backward()
    33	    return representation.weight.grad.clone(), loss.item(), counters.snapshot()
