    77	    ages = torch.tensor([r.age for r in records], dtype=torch.float32, device=device)
    78	    prev_rels = torch.tensor(
    79	        [r.reliability for r in records], dtype=torch.float32, device=device,
    80	    )
    81	
    82	    # Normalize support count: log(1 + n) / log(1 + max_n)
    83	    max_sc = support_counts.max().clamp(min=1.0)
