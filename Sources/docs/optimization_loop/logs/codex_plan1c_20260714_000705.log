    23	    """Collapse source outputs into class-keyed mean/std dictionaries."""
    24	    grouped: Dict[int, Dict[str, list]] = {}
    25	    for outputs in input_outputs.values():
    26	        if outputs is None:
    27	            continue
    28	        protos, stds = outputs
    29	        for class_id, proto in protos.items():
    30	            grouped.setdefault(class_id, {"p": [], "d": []})
    31	            grouped[class_id]["p"].append(proto)
    32	            grouped[class_id]["d"].append(stds[class_id])
