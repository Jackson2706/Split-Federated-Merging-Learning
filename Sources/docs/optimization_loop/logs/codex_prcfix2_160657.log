   144	    def test_prc_batches_classes_into_two_representation_forwards(self):
   145	        class CountingRepresentation(torch.nn.Module):
   146	            def __init__(self):
   147	                super().__init__()
   148	                self.linear = torch.nn.Linear(2, 2, bias=False)
   149	                self.calls = 0
   150	
