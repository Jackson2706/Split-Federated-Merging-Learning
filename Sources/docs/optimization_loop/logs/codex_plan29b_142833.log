    38	class Plan29SegmentationTests(unittest.TestCase):
    39	    def test_foreground_weighting_increases_all_background_penalty(self):
    40	        focal_functions = []
    41	        for path in LOSS_PATHS:
    42	            tree = ast.parse(path.read_text())
    43	            loss_class = next(node for node in tree.body if isinstance(node, ast.ClassDef))
    44	            focal_functions.append(next(
    45	                node for node in loss_class.body
    46	                if isinstance(node, ast.FunctionDef) and node.name == "focal_loss"
    47	            ))
    48	        focal_dumps = [ast.dump(node, include_attributes=False) for node in focal_functions]
    49	        self.assertTrue(all(dump == focal_dumps[0] for dump in focal_dumps[1:]))
    50	
    51	        loss = load_loss(LOSS_PATHS[0])()
    52	        target = torch.zeros(1, 1, 20, 20)
    53	        target[..., 0, 0] = 1.0
    54	        prediction = torch.full_like(target, 1e-4)
    55	
    56	        new_focal = loss.focal_loss(prediction, target)
    57	        bce = F.binary_cross_entropy(prediction, target, reduction="none")
    58	        old_uniform_focal = (loss.alpha * (1 - torch.exp(-bce)) ** loss.gamma * bce).mean()
    59	        self.assertGreater(new_focal.item(), old_uniform_focal.item())
    60	
    61	    def test_best_metrics_survive_later_collapse(self):
    62	        best = BestSegmentationMetrics()
    63	        history = [(0.12, 0.20), (0.31, 0.47), (0.25, 0.40), (0.0, 0.0)]
    64	        observed_best = []
    65	        for round_number, (iou, dice) in enumerate(history, 1):
    66	            best.update(iou, dice, round_number)
    67	            observed_best.append(best.iou)
    68	
    69	        self.assertEqual(observed_best, sorted(observed_best))
    70	        self.assertEqual((best.iou, best.dice, best.round), (0.31, 0.47, 2))
    71	
    72	    def test_align_prediction_to_mask_smoke(self):
    73	        align = load_alignment_helper()
    74	        prediction = torch.rand(2, 1, 8, 8)
    75	        mask = torch.zeros(2, 1, 16, 16)
    76	        aligned = align(prediction, mask)
    77	
    78	        self.assertEqual(aligned.shape, mask.shape)
    79	        value = load_loss(LOSS_PATHS[0])()(aligned, mask)
    80	        self.assertTrue(torch.isfinite(value))
