    26	def load_alignment_helper():
    27	    path = ROOT / "segmentation" / "HeteroSFL" / "runner.py"
    28	    tree = ast.parse(path.read_text())
    29	    function = next(
    30	        node for node in tree.body
    31	        if isinstance(node, ast.FunctionDef) and node.name == "align_prediction_to_mask"
    32	    )
    33	    namespace = {"F": F}
