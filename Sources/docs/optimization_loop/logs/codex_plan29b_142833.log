   126	def best_accuracy(metric: dict[str, Any]) -> float | str:
   127	    for key in (
   128	        "best_val_top1", "best_f1", "best_iou", "test_iou",
   129	        "final_test_f1", "test_accuracy",
   130	    ):
   131	        if metric.get(key) is not None:
   132	            value = float(metric[key])
   133	            return value * 100 if value <= 1 else value
   134	    for key in ("validation_f1", "train_accuracy", "f1"):
   135	        values = metric.get(key)
   136	        if isinstance(values, list) and values:
   137	            value = float(max(values))
   138	            return value * 100 if value <= 1 else value
   139	    return ""
   140	
   141	
   142	def macro_f1(metric: dict[str, Any]) -> float | str:
   143	    """Read a scalar or history while avoiding legacy accuracy-named-as-F1 fields."""
   144	    # Segmentation artifacts use this existing CSV column for their paired Dice
   145	    # score. Prefer the Dice value tied to the best-IoU round, never the last.
   146	    if metric.get("best_dice") is not None:
   147	        return as_percent(metric["best_dice"])
   148	    for key in ("macro_f1", "best_val_macro_f1", "final_test_f1", "test_macro_f1"):
   149	        if metric.get(key) is not None:
   150	            value = metric[key]
   151	            if isinstance(value, list):
   152	                value = max(value) if value else None
   153	            if value is not None:
   154	                value = float(value)
   155	                return value * 100 if value <= 1 else value
   156	    for key in ("validation_macro_f1", "macro_f1_history"):
   157	        values = metric.get(key)
   158	        if isinstance(values, list) and values:
   159	            value = float(max(values))
   160	            return value * 100 if value <= 1 else value
