            num_workers=0, # data already in RAM
            pin_memory=False,
            # --- end ---
            drop_last=True 
        )
        
        for epoch in range(ssl_epochs):
            total_loss = 0
            # Supervised Contrastive Training (Paper Alg. 2, Lines 9-11)
            for features, labels in syn_loader_L1:
