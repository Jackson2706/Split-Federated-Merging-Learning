   190	    device: torch.device,
   191	) -> float:
   192	    """One step of bootstrap training using heuristic reliability targets.
   193	
   194	    Uses MSE loss between predicted and heuristic reliability scores.
   195	    Returns the training loss value.
   196	    """
   197	    classes = set(r.class_id for r in memory.get_recent())
   198	    if not classes:
   199	        return 0.0
   200	
   201	    total_loss = 0.0
   202	    count = 0
   203	    reliability_net.train()
   204	
   205	    for cls_id in classes:
   206	        records = memory.get_by_class(cls_id)
   207	        if len(records) < 2:
   208	            continue
   209	
   210	        class_center = torch.stack([r.mu.to(device) for r in records]).mean(0)
