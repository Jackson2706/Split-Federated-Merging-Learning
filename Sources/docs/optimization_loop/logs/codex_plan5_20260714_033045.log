diff --git a/ehsfp/prototype_space.py b/ehsfp/prototype_space.py
new file mode 100644
index 0000000000000000000000000000000000000000..09860f2d40b270dc82aa8265b2efff1374135d47
--- /dev/null
+++ b/ehsfp/prototype_space.py
@@ -0,0 +1,104 @@
+"""Prototype-space ablations shared by H-SFP tiers."""
+
+from typing import Dict, Mapping, Optional
+
+import torch
+from torch import nn
+from torch.nn import functional as F
+
+
+PROTOTYPE_SPACES = ("raw", "centered_cosine")
+
+
+def validate_prototype_space(value: Optional[str]) -> str:
+    """Resolve the opt-in prototype space without changing legacy configs."""
+    value = "raw" if value is None else str(value)
+    if value not in PROTOTYPE_SPACES:
+        raise ValueError(
+            f"prototype_space must be one of {PROTOTYPE_SPACES}, got {value!r}"
+        )
+    return value
+
+
+@torch.no_grad()
+def derive_global_feature_mean(
+    input_outputs: Mapping,
+    support_map: Optional[Mapping] = None,
+    device: Optional[torch.device] = None,
+) -> torch.Tensor:
+    """Derive the sample-weighted global mean from existing prototype stats.
+
+    Each transmitted class prototype is already a local class mean. Its support
+    count is existing scalar metadata used by reliability; no feature tensor is
+    added to the communication payload. Missing/zero support falls back to one.
+    """
+    weighted_sum = None
+    total = 0.0
+    for source_id, outputs in input_outputs.items():
+        if outputs is None:
+            continue
+        prototypes, _ = outputs
+        for class_id, prototype in prototypes.items():
+            count = 1
+            if support_map is not None:
+                count = int(support_map.get(source_id, {}).get(class_id, 0)) or 1
+            target_device = torch.device(device) if device is not None else prototype.device
+            term = prototype.detach().to(target_device) * count
+            weighted_sum = term.clone() if weighted_sum is None else weighted_sum + term
+            total += count
+    if weighted_sum is None:
+        raise ValueError("cannot derive a global feature mean from empty prototype stats")
+    return weighted_sum / total
+
+
+def center_features(features: torch.Tensor, mean: Optional[torch.Tensor]) -> torch.Tensor:
+    """Subtract a boundary mean from batched real or synthetic features."""
+    if mean is None:
+        return features
+    return features - mean.to(device=features.device, dtype=features.dtype).unsqueeze(0)
+
+
+def center_source_outputs(input_outputs: Mapping, mean: torch.Tensor) -> Dict:
+    """Return prototype dictionaries expressed in the centered space."""
+    centered = {}
+    for source_id, outputs in input_outputs.items():
+        if outputs is None:
+            centered[source_id] = None
+            continue
+        prototypes, stds = outputs
+        centered[source_id] = (
+            {
+                class_id: prototype - mean.to(prototype.device, prototype.dtype)
+                for class_id, prototype in prototypes.items()
+            },
+            stds,
+        )
+    return centered
+
+
+@torch.no_grad()
+def recenter_memory(memory, old_mean: Optional[torch.Tensor], new_mean: torch.Tensor) -> None:
+    """Move historical centered records into a newly selected centered frame."""
+    if memory is None or old_mean is None:
+        return
+    shift = old_mean.detach().cpu() - new_mean.detach().cpu()
+    for record in memory.get_recent():
+        record.mu = record.mu + shift.to(record.mu.dtype)
+
+
+class CosineClassifier(nn.Module):
+    """Angular classifier: ``logits = scale * cosine(weight, feature)``."""
+
+    def __init__(self, in_features: int, num_classes: int, initial_scale: float = 16.0):
+        super().__init__()
+        self.in_features = int(in_features)
+        self.num_classes = int(num_classes)
+        self.weight = nn.Parameter(torch.empty(num_classes, in_features))
+        self.scale = nn.Parameter(torch.tensor(float(initial_scale)))
+        nn.init.xavier_uniform_(self.weight)
+
+    def forward(self, features: torch.Tensor) -> torch.Tensor:
+        features = features.reshape(features.shape[0], -1)
+        return self.scale * F.linear(
+            F.normalize(features, dim=1), F.normalize(self.weight, dim=1)
+        )
diff --git a/tests/test_plan5_prototype_space.py b/tests/test_plan5_prototype_space.py
new file mode 100644
index 0000000000000000000000000000000000000000..1b00cd0f2cc76fd166117e496c4cbf2685b58846
--- /dev/null
+++ b/tests/test_plan5_prototype_space.py
@@ -0,0 +1,141 @@
+import importlib.util
+from pathlib import Path
+import unittest
+
+import torch
+from torch import nn
+from torch.nn import functional as F
+
+from ehsfp.prototype_space import (
+    CosineClassifier,
+    center_features,
+    center_source_outputs,
+    derive_global_feature_mean,
+    validate_prototype_space,
+)
+
+
+ROOT = Path(__file__).resolve().parents[1]
+
+
+def _load_hierarchy():
+    spec = importlib.util.spec_from_file_location(
+        "classification_hsfp_hierarchy", ROOT / "classification/H-SFP/hierarchy.py"
+    )
+    module = importlib.util.module_from_spec(spec)
+    spec.loader.exec_module(module)
+    return module
+
+
+def _load_cifar_models():
+    spec = importlib.util.spec_from_file_location(
+        "classification_hsfp_cnn", ROOT / "classification/H-SFP/models/cnn_cifar.py"
+    )
+    module = importlib.util.module_from_spec(spec)
+    spec.loader.exec_module(module)
+    return module
+
+
+class _Client(nn.Module):
+    def forward(self, x):
+        return x
+
+
+class _Edge(nn.Module):
+    def __init__(self):
+        super().__init__()
+        self.last_input = None
+
+    def forward(self, x):
+        self.last_input = x.detach().clone()
+        return 2.0 * x
+
+
+class _Cloud(nn.Module):
+    def __init__(self):
+        super().__init__()
+        self.last_input = None
+
+    def forward(self, x):
+        self.last_input = x.detach().clone()
+        return x
+
+
+class Plan5PrototypeSpaceTests(unittest.TestCase):
+    @classmethod
+    def setUpClass(cls):
+        cls.hierarchy = _load_hierarchy()
+        cls.cifar_models = _load_cifar_models()
+
+    def test_raw_regression_is_numerically_identical_to_legacy_pipeline(self):
+        torch.manual_seed(7)
+        client, edge, cloud = _Client(), _Edge(), nn.Linear(3, 4)
+        x = torch.randn(5, 3, 1, 1)
+
+        legacy = cloud(torch.flatten(nn.AdaptiveAvgPool2d((1, 1))(edge(client(x))), 1))
+        raw = self.hierarchy.FullPipelineModel(client, edge, cloud)(x)
+
+        self.assertEqual(validate_prototype_space(None), "raw")
+        self.assertTrue(torch.equal(raw, legacy))
+
+    def test_raw_cloud_head_matches_current_hsfp_formula(self):
+        torch.manual_seed(11)
+        model = self.cifar_models.CloudModel({"num_classes": 100}).eval()
+        features = torch.randn(8, 256)
+        expected = model.classifier(F.normalize(features, dim=1) * model.feat_scale)
+        actual = model(features)
+        self.assertTrue(torch.equal(actual, expected))
+        self.assertFalse(hasattr(model, "cosine_head"))
+
+    def test_centered_prototypes_have_zero_support_weighted_global_mean(self):
+        outputs = {
+            "a": ({0: torch.tensor([1.0, 3.0]), 1: torch.tensor([5.0, 7.0])},
+                  {0: torch.ones(2), 1: torch.ones(2)}),
+            "b": ({0: torch.tensor([9.0, 11.0])}, {0: torch.ones(2)}),
+        }
+        support = {"a": {0: 2, 1: 1}, "b": {0: 3}}
+        mean = derive_global_feature_mean(outputs, support)
+        centered = center_source_outputs(outputs, mean)
+        post_mean = derive_global_feature_mean(centered, support)
+
+        self.assertTrue(torch.allclose(post_mean, torch.zeros_like(post_mean), atol=1e-6))
+        self.assertEqual(
+            sum(t.numel() for pair in outputs.values() for d in pair for t in d.values()),
+            sum(t.numel() for pair in centered.values() for d in pair for t in d.values()),
+        )
+        self.assertEqual(len(centered["a"]), 2)  # no transmitted mean tensor
+
+    def test_cosine_head_is_scale_times_cosine(self):
+        head = CosineClassifier(3, 2, initial_scale=7.0)
+        with torch.no_grad():
+            head.weight.copy_(torch.tensor([[1.0, 2.0, 0.0], [-1.0, 0.0, 1.0]]))
+        features = torch.tensor([[2.0, 1.0, 2.0], [0.0, 3.0, 4.0]])
+        expected = 7.0 * F.normalize(features, dim=1) @ F.normalize(head.weight, dim=1).T
+        self.assertTrue(torch.allclose(head(features), expected, atol=1e-7))
+        self.assertTrue(head.scale.requires_grad)
+
+    def test_train_and_eval_use_the_same_boundary_centering(self):
+        client, edge, cloud = _Client(), _Edge(), _Cloud()
+        mu_l1 = torch.tensor([[[1.0]], [[-2.0]], [[0.5]]])
+        mu_l2 = torch.tensor([2.0, -4.0, 1.0])
+        real = torch.tensor([[[[3.0]], [[1.0]], [[2.5]]]])
+        pipeline = self.hierarchy.FullPipelineModel(
+            client, edge, cloud, prototype_space="centered_cosine",
+            client_to_edge_mean=mu_l1, edge_to_cloud_mean=mu_l2,
+        )
+
+        result = pipeline(real)
+        training_l1 = center_features(real, mu_l1)
+        training_l2 = center_features(2.0 * training_l1.flatten(1), mu_l2)
+
+        self.assertTrue(torch.equal(edge.last_input, training_l1))
+        self.assertTrue(torch.equal(cloud.last_input, training_l2))
+        self.assertTrue(torch.equal(result, training_l2))
+
+    def test_invalid_space_is_rejected(self):
+        with self.assertRaises(ValueError):
+            validate_prototype_space("whitened_cosine")
+
+
+if __name__ == "__main__":
+    unittest.main()

Matched proxy overrides were resolved without training; raw and centered commands use the same PLAN-2 config/partition/seed and distinct output directories.
