   212	        targets = compute_heuristic_reliability(records, device=device)
   213	
   214	        preds = reliability_net(feats)
   215	        loss = torch.nn.functional.mse_loss(preds, targets)
   216	
   217	        optimizer.zero_grad()
   218	        loss.backward()
   219	        optimizer.step()
   220	
   221	        total_loss += loss.item()
   222	        count += 1
