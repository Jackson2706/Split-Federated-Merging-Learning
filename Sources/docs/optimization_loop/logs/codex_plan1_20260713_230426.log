diff --git a/docs/optimization_loop/logs/plan1_smoke_20260713/run_smoke_wrapper.py b/docs/optimization_loop/logs/plan1_smoke_20260713/run_smoke_wrapper.py
new file mode 100644
index 0000000000000000000000000000000000000000..4186f0bd9708f75cd19843e1defd3645181eae4a
--- /dev/null
+++ b/docs/optimization_loop/logs/plan1_smoke_20260713/run_smoke_wrapper.py
@@ -0,0 +1,55 @@
+"""Local PLAN-1 execution shim; training semantics remain config-driven.
+
+The sandbox cannot create DataLoader worker sockets, and the production CIFAR
+loader has no subset knob. This shim makes those two smoke-only execution
+constraints effective before dispatching to the unified main.py entry point.
+"""
+
+import os
+import runpy
+import sys
+
+import numpy as np
+from torch.utils.data import Subset
+
+
+ROOT = os.path.abspath(os.path.join(os.path.dirname(__file__), "..", "..", "..", ".."))
+METHOD_DIR = os.path.join(ROOT, "classification", "H-SFP")
+sys.path.insert(0, ROOT)
+sys.path.insert(0, METHOD_DIR)
+
+import data  # noqa: E402
+import hierarchy  # noqa: E402
+
+
+_get_dataset = data.get_dataset
+
+
+def _bounded_get_dataset(args):
+    train, valid, test, groups = _get_dataset(args)
+    cap = int(args["smoke_train_samples_per_client"])
+    bounded_groups = {}
+    for client_id, indices in groups.items():
+        ordered = np.asarray(sorted(int(i) for i in indices), dtype=np.int64)
+        positions = np.linspace(0, len(ordered) - 1, min(cap, len(ordered)), dtype=np.int64)
+        bounded_groups[client_id] = ordered[positions]
+
+    eval_cap = min(int(args["smoke_eval_samples"]), len(valid), len(test))
+    eval_indices = list(range(eval_cap))
+    return train, Subset(valid, eval_indices), Subset(test, eval_indices), bounded_groups
+
+
+data.get_dataset = _bounded_get_dataset
+
+_hierarchy_init = hierarchy.HierarchicalFL.__init__
+
+
+def _zero_worker_init(self, *args, **kwargs):
+    _hierarchy_init(self, *args, **kwargs)
+    self.num_workers = 0
+
+
+hierarchy.HierarchicalFL.__init__ = _zero_worker_init
+
+os.chdir(ROOT)
+runpy.run_path(os.path.join(ROOT, "main.py"), run_name="__main__")

diff --git a/configs/smoke/plan1_cifar100_ehsfp_gate.yaml b/configs/smoke/plan1_cifar100_ehsfp_gate.yaml
new file mode 100644
index 0000000000000000000000000000000000000000..abc84bb8495351bc63e1807f0805757d09f5ae03
--- /dev/null
+++ b/configs/smoke/plan1_cifar100_ehsfp_gate.yaml
@@ -0,0 +1,39 @@
+# PLAN-1 only: bounded CIFAR-100 instrumentation smoke gate.
+# The execution harness deterministically caps the locally cached CIFAR-100
+# partition to 32 train samples/client and 128 validation/test samples.
+# This config is not suitable for accuracy or paper-number comparisons.
+base: ../classification/h-sfp/cifar_our_resnet50_5_10.yaml
+
+is_gpu: false
+iid: true
+num_users: 8
+mid_server: [2]
+epochs: 2
+frac: 1.0
+t1: 1
+t2: 2
+eval_every: 2
+
+local_bs: 16
+ssl_epochs_client: 1
+ssl_epochs_edge: 1
+syn_epochs_cloud: 1
+syn_samples_per_class: 16
+use_lr_schedule: false
+
+smoke_train_samples_per_client: 32
+smoke_eval_samples: 128
+
+# Keep the smoke paths small while ensuring the full preset can exercise them.
+memory_size: 10000
+memory_top_k: 2
+prc_num_samples: 2
+
+# full_e_hsfp enables the simulator; eliminate simulated timeouts so the
+# instrumentation gate observes every selected client in both rounds.
+cold_start_probability: 0.0
+function_timeout_probability: 0.0
+
+# Distinguishes the sandbox-safe zero-worker retry from the preserved failed
+# preflight directory; it has no training semantics.
+smoke_attempt_id: plan1_cpu_tiny_v2
