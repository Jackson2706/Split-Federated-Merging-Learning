+    _hierarchy_init(self, *args, **kwargs)
+    self.num_workers = 0
+
+
+hierarchy.HierarchicalFL.__init__ = _zero_worker_init
+
+os.chdir(ROOT)
+runpy.run_path(os.path.join(ROOT, "main.py"), run_name="__main__")

