+    eval_indices = list(range(eval_cap))
+    return train, Subset(valid, eval_indices), Subset(test, eval_indices), bounded_groups
+
+
+data.get_dataset = _bounded_get_dataset
+
+_hierarchy_init = hierarchy.HierarchicalFL.__init__
+
+
