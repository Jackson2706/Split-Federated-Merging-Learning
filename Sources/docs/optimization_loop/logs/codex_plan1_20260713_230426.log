            all_stds[cls_id] = stacked.std(0, unbiased=False).cpu()
            support_counts[int(cls_id)] = len(tensors)

        # Manual cleanup
        del feats_by_cls
        gc.collect()
        return (all_protos, all_stds), support_counts

