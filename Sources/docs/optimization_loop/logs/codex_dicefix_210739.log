     6	class DiceFocalLoss(nn.Module):
     7	    def __init__(
     8	        self, alpha=0.25, gamma=2.0, smooth=1.0, eps=1e-7, debug=False
     9	    ):
    10	        super(DiceFocalLoss, self).__init__()
    11	        self.alpha = alpha
    12	        self.gamma = gamma
    13	        self.smooth = smooth
    14	        self.eps = eps
    15	        self.debug = debug
    16	
    17	    def _sanity_check(self, preds, targets):
    18	        if targets.dtype != torch.float32:
    19	            targets = targets.float()
    20	        if preds.dim() == 3:
    21	            preds = preds.unsqueeze(1)
    22	        if targets.dim() == 3:
    23	            targets = targets.unsqueeze(1)
    24	        if preds.shape != targets.shape:
    25	            raise ValueError(
    26	                f"[DiceFocalLoss] Shape mismatch: preds {preds.shape}, targets {targets.shape}"
    27	            )
    28	        # Guard against non-finite predictions (NaN/inf) before clamping:
    29	        # torch.clamp PROPAGATES NaN, which then trips the BCE CUDA assert
    30	        # `input_val >= 0 && input_val <= 1`. Since preds are probabilities,
    31	        # map nan->0, +inf->1, -inf->0, then clamp into (eps, 1-eps).
    32	        preds = torch.nan_to_num(preds, nan=0.0, posinf=1.0, neginf=0.0)
    33	        preds = torch.clamp(preds, min=self.eps, max=1 - self.eps)
    34	        return preds, targets
    35	
    36	    def dice_loss(self, preds, targets):
    37	        preds = preds.contiguous().view(-1)
    38	        targets = targets.contiguous().view(-1)
    39	        intersection = (preds * targets).sum()
    40	        dice = (2.0 * intersection + self.smooth) / (
    41	            preds.sum() + targets.sum() + self.smooth
    42	        )
    43	        return 1 - dice
    44	
    45	    def focal_loss(self, preds, targets):
    46	        preds = preds.contiguous().view(-1)
    47	        targets = targets.contiguous().view(-1)
    48	        bce = F.binary_cross_entropy(preds, targets, reduction="none")
    49	        pt = torch.exp(-bce)
    50	        focal = self.alpha * (1 - pt) ** self.gamma * bce
    51	        return focal.mean()
    52	
    53	    def forward(self, preds, targets):
    54	        # F.binary_cross_entropy (used by focal_loss) is unsafe under autocast,
    55	        # and this loss operates on probabilities. Force a float32, autocast-off
    56	        # region so it is safe whether or not the caller is inside autocast.
    57	        with torch.autocast(device_type=preds.device.type, enabled=False):
    58	            preds = preds.float()
    59	            targets = targets.float()
    60	            preds, targets = self._sanity_check(preds, targets)
    61	            loss_dice = self.dice_loss(preds, targets)
    62	            loss_focal = self.focal_loss(preds, targets)
    63	            return loss_dice + loss_focal

