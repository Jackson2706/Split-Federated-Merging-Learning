    94	    def append_jsonl(self, path: str, extra: Optional[Dict] = None) -> None:
    95	        """Persist an epoch record without display rounding.
    96	
    97	        Diagnostic metrics can occasionally be NaN/Inf (e.g. a degenerate
    98	        per-class reliability variance); sanitize to null so a single non-finite
    99	        diagnostic never aborts the whole run's logging (and final test/metrics
   100	        write). This keeps runs robust without hiding real training divergence,
   101	        which is already tracked via the finite loss/accuracy fields.
   102	        """
   103	        import math
   104	
   105	        def _sanitize(o):
   106	            if isinstance(o, float):
   107	                return o if math.isfinite(o) else None
   108	            if isinstance(o, dict):
   109	                return {k: _sanitize(v) for k, v in o.items()}
   110	            if isinstance(o, (list, tuple)):
   111	                return [_sanitize(v) for v in o]
   112	            return o
   113	
