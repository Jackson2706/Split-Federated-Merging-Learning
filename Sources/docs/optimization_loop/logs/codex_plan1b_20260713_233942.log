   884	        if syn_features_L2.shape[0] == 0:
   885	            print(f"Cloud {cloud_id}: no prototypes from edges, skipping.")
   886	            return 0.0
   887	
   888	        print(f"Cloud {cloud_id}: generated {syn_features_L2.shape[0]} L2 samples (original labels). Starting supervised...")
   889	
   890	        # --- 3b. Supervised training (CrossEntropy) ---
   891	        model.to(self.device).train()
   892	        
   893	        syn_dataset_L2 = torch.utils.data.TensorDataset(
   894	            syn_features_L2.cpu(), 
   895	            syn_labels_L2.cpu() # original labels (e.g. 0-99)
   896	        )
   897	        del syn_features_L2, syn_labels_L2
   898	        
   899	        syn_loader_L2 = DataLoader(
   900	            syn_dataset_L2, 
   901	            batch_size=self.args['local_bs'], 
   902	            shuffle=True,
   903	            # --- fix AttributeError ---
   904	            num_workers=0,
   905	            pin_memory=False,
   906	            # --- end ---
   907	            drop_last=True
   908	        )
   909	        
   910	        total_loss = 0
   911	        for epoch in range(syn_epochs):
   912	            epoch_loss = 0
   913	            for features, labels in syn_loader_L2:
   914	                features, labels = features.to(self.device), labels.to(self.device, non_blocking=True)
   915	                
   916	                # Avoid FutureWarning
