   860	    def _cloud_supervised_phase(self, cloud_id, edge_outputs, syn_epochs, syn_samples_per_class):
   861	        """(Phase 3) Run supervised training for the cloud."""
   862	        model = self.structure[len(self.args["mid_server"])][cloud_id]
