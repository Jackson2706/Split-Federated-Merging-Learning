    30	class Phase0EffectTests(unittest.TestCase):
    31	    def test_memory_replay_changes_prototype(self):
    32	        memory = EpisodicPrototypeMemory(max_size=4, max_age=2)
    33	        memory.add(PrototypeRecord(
    34	            0, torch.tensor([10.0, 12.0]), torch.ones(2), 4, "old", 0,
    35	        ))
    36	        counters = RuntimeCounters()
    37	        current_p = {0: torch.tensor([0.0, 2.0])}
    38	        current_d = {0: torch.ones(2)}
    39	        mixed_p, _ = mix_current_and_memory(
    40	            current_p, current_d, memory, alpha=0.5,
    41	            runtime_counters=counters,
    42	        )
    43	        self.assertTrue(torch.equal(mixed_p[0], torch.tensor([5.0, 7.0])))
    44	        self.assertEqual(counters.snapshot()["memory.changed_classes"], 1)
    45	
    46	    def test_reliability_weights_are_nonuniform_for_unequal_inputs(self):
    47	        net = PrototypeReliabilityNetwork(hidden_dim=2)
    48	        with torch.no_grad():
    49	            for parameter in net.parameters():
    50	                parameter.zero_()
    51	            net.net[0].weight[0, 0] = 1.0
    52	            net.net[2].weight[0, 0] = 1.0
    53	            net.net[4].weight[0, 0] = 1.0
    54	        features = torch.zeros(2, 6)
    55	        features[1, 0] = 1.0
    56	        weights = net(features)
    57	        self.assertGreater(weights[1], weights[0])
    58	        self.assertFalse(torch.allclose(weights, weights[0].expand_as(weights)))
