+def aggregate_proto_dicts(input_outputs: Dict) -> Tuple[Dict[int, torch.Tensor], Dict[int, torch.Tensor]]:
+    """Collapse source outputs into class-keyed mean/std dictionaries."""
+    grouped: Dict[int, Dict[str, list]] = {}
