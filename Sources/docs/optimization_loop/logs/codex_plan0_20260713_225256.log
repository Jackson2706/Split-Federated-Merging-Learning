    14	
    15	def _jsonable(value: Any) -> Any:
    16	    if isinstance(value, Mapping):
    17	        return {str(k): _jsonable(v) for k, v in sorted(value.items(), key=lambda x: str(x[0]))}
    18	    if isinstance(value, (list, tuple)):
    19	        return [_jsonable(v) for v in value]
    20	    if isinstance(value, set):
    21	        return sorted(_jsonable(v) for v in value)
    22	    if hasattr(value, "item"):
    23	        try:
    24	            return value.item()
    25	        except (ValueError, TypeError):
    26	            pass
    27	    return value
    28	
    29	
    30	def canonical_config(config: Mapping[str, Any]) -> str:
    31	    """Return stable, unrounded JSON for a fully resolved configuration."""
    32	    return json.dumps(_jsonable(config), sort_keys=True, separators=(",", ":"), allow_nan=False)
    33	
    34	
    35	def resolved_config_hash(config: Mapping[str, Any], effective_ehsfp: Mapping[str, Any]) -> str:
    36	    payload = {"config": dict(config), "effective_ehsfp": dict(effective_ehsfp)}
    37	    return hashlib.sha256(canonical_config(payload).encode()).hexdigest()
    38	
    39	
    40	def partition_hash(user_groups: Mapping[Any, Iterable[Any]]) -> str:
    41	    normalized = {str(k): sorted(int(i) for i in v) for k, v in user_groups.items()}
    42	    return hashlib.sha256(canonical_config(normalized).encode()).hexdigest()
    43	
    44	
    45	def git_commit(root: str) -> str:
    46	    return subprocess.check_output(["git", "rev-parse", "HEAD"], cwd=root, text=True).strip()
    47	
    48	
    49	def architecture_manifest(models: Sequence[Any]) -> Dict[str, Any]:
    50	    tiers = []
    51	    for model in models:
    52	        cls = type(model)
    53	        try:
    54	            source = inspect.getsourcefile(cls) or "unknown"
    55	            source_digest = hashlib.sha256(Path(source).read_bytes()).hexdigest()
    56	        except (OSError, TypeError):
    57	            source, source_digest = "unknown", "unknown"
    58	        tiers.append({
    59	            "class": f"{cls.__module__}.{cls.__qualname__}",
    60	            "source": os.path.abspath(source) if source != "unknown" else source,
    61	            "source_sha256": source_digest,
    62	            "state_shapes": {k: list(v.shape) for k, v in model.state_dict().items()},
    63	            "parameters": sum(p.numel() for p in model.parameters()),
    64	            "trainable_parameters": sum(p.numel() for p in model.parameters() if p.requires_grad),
    65	        })
    66	    digest = hashlib.sha256(canonical_config(tiers).encode()).hexdigest()
    67	    return {"architecture_hash": digest, "architecture_id": digest[:12], "tiers": tiers}
    68	
    69	
    70	def prepare_run_dir(base_dir: str, architecture_id: str, config_hash: str) -> str:
    71	    """Reserve an architecture/config-specific directory without overwriting."""
    72	    run_dir = os.path.join(base_dir, architecture_id, config_hash)
    73	    if os.path.exists(run_dir):
    74	        raise FileExistsError(
    75	            f"Refusing to overwrite existing run directory {run_dir}; "
    76	            "use a distinct resolved config or archive the existing run."
    77	        )
    78	    os.makedirs(run_dir, exist_ok=False)
    79	    return run_dir
    80	
    81	
    82	def validate_checkpoint_config_hash(checkpoint: Mapping[str, Any], expected_hash: str) -> None:
    83	    found = checkpoint.get("resolved_config_hash")
    84	    if found != expected_hash:
    85	        raise RuntimeError(
    86	            f"Checkpoint config hash mismatch: expected {expected_hash}, found {found!r}"
    87	        )
