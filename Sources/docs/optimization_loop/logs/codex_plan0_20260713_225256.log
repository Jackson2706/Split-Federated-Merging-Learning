index 67b3ff715e5e34ec5303ec5e5604023d4d0fe3ca..cdec935200153cbe37f5c61c6ed93b5cee6a1ad3
--- a/ehsfp/losses.py
+++ b/ehsfp/losses.py
@@ -19,6 +19,7 @@
     representation_fn: Callable[[torch.Tensor], torch.Tensor],
     num_samples: int = 16,
     device: Optional[torch.device] = None,
+    runtime_counters=None,
