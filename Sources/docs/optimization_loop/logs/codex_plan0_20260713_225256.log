diff --git a/tests/test_phase0_effects.py b/tests/test_phase0_effects.py
new file mode 100644
index 0000000000000000000000000000000000000000..dc8ef896744e49b2bca27e15986428258635e95c
--- /dev/null
+++ b/tests/test_phase0_effects.py
@@ -0,0 +1,107 @@
+import json
+
+import pytest
+import torch
+
+from ehsfp import (
+    ABLATION_PRESETS,
+    EHSFP_DEFAULTS,
+    EpisodicPrototypeMemory,
+    PrototypeDropout,
+    PrototypeRecord,
+    PrototypeReliabilityNetwork,
+    RuntimeCounters,
+    get_ehsfp_config,
+    mix_current_and_memory,
+    prepare_run_dir,
+    prototype_replay_consistency_loss,
+    resolved_config_hash,
+    validate_checkpoint_config_hash,
+)
+
+
+def test_memory_replay_changes_prototype():
+    memory = EpisodicPrototypeMemory(max_size=4, max_age=2)
+    memory.add(PrototypeRecord(0, torch.tensor([10.0, 12.0]), torch.ones(2), 4, "old", 0))
+    counters = RuntimeCounters()
+    current_p = {0: torch.tensor([0.0, 2.0])}
+    current_d = {0: torch.ones(2)}
+    mixed_p, _ = mix_current_and_memory(current_p, current_d, memory, alpha=0.5, runtime_counters=counters)
+    assert torch.equal(mixed_p[0], torch.tensor([5.0, 7.0]))
+    assert counters.snapshot()["memory.changed_classes"] == 1
+
+
+def test_reliability_weights_are_nonuniform_for_unequal_inputs():
+    net = PrototypeReliabilityNetwork(hidden_dim=2)
+    with torch.no_grad():
+        for parameter in net.parameters():
+            parameter.zero_()
+        net.net[0].weight[0, 0] = 1.0
+        net.net[2].weight[0, 0] = 1.0
+        net.net[4].weight[0, 0] = 1.0
+    features = torch.zeros(2, 6)
+    features[1, 0] = 1.0
+    weights = net(features)
+    assert weights[1] > weights[0]
+    assert not torch.allclose(weights, weights[0].expand_as(weights))
+
+
+def _prc_gradient(memory_mu):
+    representation = torch.nn.Linear(2, 1, bias=False)
+    representation.weight.data.copy_(torch.tensor([[1.0, -0.5]]))
+    counters = RuntimeCounters()
+    loss = prototype_replay_consistency_loss(
+        {0: torch.tensor([1.0, 2.0])}, {0: torch.zeros(2)},
+        {0: torch.tensor(memory_mu)}, {0: torch.zeros(2)},
+        representation, num_samples=3, device=torch.device("cpu"),
+        runtime_counters=counters,
+    )
+    loss.backward()
+    return representation.weight.grad.clone(), loss.item(), counters.snapshot()
+
+
+def test_prc_changes_trainable_gradient_when_inputs_differ():
+    same_grad, same_loss, _ = _prc_gradient([1.0, 2.0])
+    changed_grad, changed_loss, counters = _prc_gradient([3.0, -1.0])
+    assert same_loss == 0.0
+    assert torch.equal(same_grad, torch.zeros_like(same_grad))
+    assert changed_loss > 0.0
+    assert not torch.equal(changed_grad, same_grad)
+    assert counters["prc.shared_classes"] == 1
+    assert counters["prc.nonzero_loss_calls"] == 1
+
+
+def test_dropout_changes_active_client_ids_when_enabled():
+    active = {client_id: object() for client_id in range(5)}
+    dropout = PrototypeDropout(rate=1.0, seed=17)
+    kept = dropout.apply_to_source_outputs(active)
+    assert set(kept) != set(active)
+    assert len(kept) == 1
+    assert dropout.stats["changed_calls"] == 1
+
+
+def test_ablation_presets_resolve_to_distinct_effective_configs_and_hashes():
+    base = dict(EHSFP_DEFAULTS)
+    effective, hashes = {}, {}
+    for name in ABLATION_PRESETS:
+        cfg = {**base, "dataset": "cifar100", "ablation_mode": name}
+        effective[name] = get_ehsfp_config(cfg)
+        hashes[name] = resolved_config_hash(cfg, effective[name])
+    assert len(set(json.dumps(v, sort_keys=True) for v in effective.values())) == len(effective)
+    assert len(set(hashes.values())) == len(hashes)
+    assert effective["full_e_hsfp"]["use_prc_loss"] is True
+    assert effective["baseline_hsfp"]["use_prc_loss"] is False
+
+
+def test_checkpoint_hash_mismatch_is_refused():
+    validate_checkpoint_config_hash({"resolved_config_hash": "same"}, "same")
+    with pytest.raises(RuntimeError, match="mismatch"):
+        validate_checkpoint_config_hash({"resolved_config_hash": "old"}, "new")
+
+
+def test_result_directory_guard_separates_architectures_and_refuses_overwrite(tmp_path):
+    first = prepare_run_dir(str(tmp_path), "legacy-split", "abc")
+    second = prepare_run_dir(str(tmp_path), "new-split", "abc")
+    assert first != second
+    with pytest.raises(FileExistsError, match="Refusing to overwrite"):
+        prepare_run_dir(str(tmp_path), "legacy-split", "abc")

