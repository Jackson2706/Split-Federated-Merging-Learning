    90	class RuntimeCounters:
    91	    """Small serializable counter set shared by all E-HSFP components."""
    92	
    93	    def __init__(self) -> None:
    94	        self._counts: Counter[str] = Counter()
    95	
    96	    def increment(self, key: str, amount: int = 1) -> None:
    97	        self._counts[key] += int(amount)
    98	
    99	    def snapshot(self) -> Dict[str, int]:
   100	        return dict(sorted(self._counts.items()))
    96	
    97	
    98	def get_ehsfp_config(user_config: dict) -> dict:
    99	    """Merge E-HSFP defaults with user config, applying ablation preset if set."""
   100	    cfg = dict(EHSFP_DEFAULTS)
   101	    # Load the resolved YAML first.  The repository defaults contain explicit
   102	    # ``false`` values, so applying them after a preset silently disabled every
   103	    # ablation selected by the CLI.
   104	    for k in EHSFP_DEFAULTS:
   105	        if k in user_config:
   106	            cfg[k] = user_config[k]
   107	    # An ablation is an effective configuration preset and therefore wins over
   108	    # inherited YAML defaults (matching the comments in default.yaml).
   109	    ablation = user_config.get("ablation_mode")
   110	    if ablation:
   111	        if ablation not in ABLATION_PRESETS:
   112	            raise ValueError(f"Unknown E-HSFP ablation preset: {ablation}")
   113	        cfg.update(ABLATION_PRESETS[ablation])
   114	        cfg["ablation_mode"] = ablation
   115	    return cfg
