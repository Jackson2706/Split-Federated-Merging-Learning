    16	def _prc_gradient(memory_mu):
    17	    representation = torch.nn.Linear(2, 1, bias=False)
    18	    representation.weight.data.copy_(torch.tensor([[1.0, -0.5]]))
    19	    counters = RuntimeCounters()
    20	    loss = prototype_replay_consistency_loss(
    21	        {0: torch.tensor([1.0, 2.0])}, {0: torch.zeros(2)},
    22	        {0: torch.tensor(memory_mu)}, {0: torch.zeros(2)},
    23	        representation, num_samples=3, device=torch.device("cpu"),
    24	        runtime_counters=counters,
    25	    )
    26	    loss.backward()
    27	    return representation.weight.grad.clone(), loss.item(), counters.snapshot()
