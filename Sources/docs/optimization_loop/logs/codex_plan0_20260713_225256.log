import json, yaml
from pathlib import Path
from ehsfp import ABLATION_PRESETS, get_ehsfp_config, resolved_config_hash

def load(path):
    data=yaml.safe_load(path.read_text()) or {}
    if 'base' in data:
        base=load(path.parent/data.pop('base'))
        base.update(data)
        return base
    return data
