diff --git a/ehsfp/aggregation.py b/ehsfp/aggregation.py
index 35c9dd0e5e610982a18d46dc182f7cb05c6f9650..c7a53899e5a5dafdbd6734b6c575e95349df2d1e
--- a/ehsfp/aggregation.py
+++ b/ehsfp/aggregation.py
@@ -16,6 +16,24 @@
 )
 
 
+def aggregate_proto_dicts(input_outputs: Dict) -> Tuple[Dict[int, torch.Tensor], Dict[int, torch.Tensor]]:
+    """Collapse source outputs into class-keyed mean/std dictionaries."""
+    grouped: Dict[int, Dict[str, list]] = {}
+    for outputs in input_outputs.values():
+        if outputs is None:
+            continue
+        protos, stds = outputs
+        for class_id, proto in protos.items():
+            grouped.setdefault(class_id, {"p": [], "d": []})
+            grouped[class_id]["p"].append(proto)
+            grouped[class_id]["d"].append(stds[class_id])
+    merged_p, merged_d = {}, {}
+    for class_id, values in grouped.items():
+        merged_p[class_id] = torch.stack(values["p"]).mean(0)
+        merged_d[class_id] = torch.sqrt(torch.stack([d ** 2 for d in values["d"]]).mean(0))
+    return merged_p, merged_d
+
+
 def reliability_weighted_aggregate(
