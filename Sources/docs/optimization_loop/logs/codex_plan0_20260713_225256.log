    60	    def test_prc_changes_trainable_gradient_when_inputs_differ(self):
    61	        same_grad, same_loss, _ = _prc_gradient([1.0, 2.0])
    62	        changed_grad, changed_loss, counters = _prc_gradient([3.0, -1.0])
    63	        self.assertEqual(same_loss, 0.0)
    64	        self.assertTrue(torch.equal(same_grad, torch.zeros_like(same_grad)))
    65	        self.assertGreater(changed_loss, 0.0)
    66	        self.assertFalse(torch.equal(changed_grad, same_grad))
    67	        self.assertEqual(counters["prc.shared_classes"], 1)
    68	        self.assertEqual(counters["prc.nonzero_loss_calls"], 1)
