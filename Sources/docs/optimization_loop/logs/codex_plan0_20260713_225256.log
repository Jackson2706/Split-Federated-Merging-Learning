            # E-HSFP: Begin serverless episode
            if self.serverless_tracker is not None:
                self.serverless_tracker.begin_episode(epoch)

            m = max(int(frac * num_users), 1)
            idxs_users = np.random.choice(range(num_users), m, replace=False)
            client_outputs = {}
