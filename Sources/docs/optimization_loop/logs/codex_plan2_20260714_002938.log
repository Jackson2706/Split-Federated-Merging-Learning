/bin/bash -lc "python - <<'PY'
import importlib.util
from pathlib import Path
from ehsfp import get_ehsfp_config, resolved_config_hash
root=Path('.')
items=[
 ('splitfl','classification/SplitFL/config/config_loader.py','configs/proxy/plan2_cifar100_splitfl.yaml'),
 ('federated','classification/Federated/config/config_loader.py','configs/proxy/plan2_cifar100_federated.yaml'),
 ('h-sfp-baseline','classification/H-SFP/config/config_loader.py','configs/proxy/plan2_cifar100_hsfp_baseline.yaml'),
 ('h-sfp-full-e','classification/H-SFP/config/config_loader.py','configs/proxy/plan2_cifar100_hsfp_full_e.yaml'),
]
hashes=[]; outs=[]
for i,(name,loader,cfg) in enumerate(items):
 spec=importlib.util.spec_from_file_location(f'cfg_loader_{i}',loader)
 mod=importlib.util.module_from_spec(spec); spec.loader.exec_module(mod)
 c=mod.ConfigLoader(cfg).get_config()
 h=resolved_config_hash(c,get_ehsfp_config(c))
 hashes.append(h); outs.append(c['output_dir'])
 print(name, h, c['output_dir'])
 print(' ', {k:c.get(k) for k in ('dataset','model','strategy','epochs','num_users','frac','local_ep','ssl_epochs_client','ssl_epochs_edge','syn_epochs_cloud','iid','partition','seed','ablation_mode','optimizer','lr','use_lr_schedule')})
assert len(set(hashes))==4, hashes
assert len(set(outs))==4, outs
PY
