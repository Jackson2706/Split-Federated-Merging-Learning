/bin/bash -lc "python - <<'PY'
from pathlib import Path
import sys
import numpy as np
from tools.fair_compare.aggregate import resolve_yaml
from ehsfp.integrity import partition_hash

paths = sorted(Path('configs/proxy').glob('plan_ham10000_*.yaml'))
common = ('dataset','metadata_path','image_dirs','model','num_classes','epochs','iid','partition','num_users','frac','evaluation_metrics','primary_metric')
resolved = {p.name: resolve_yaml(p) for p in paths}
for name, cfg in resolved.items():
    missing = [k for k in common if k not in cfg]
    assert not missing, (name, missing)
    assert cfg['dataset'] == 'ham10000'
    assert cfg['epochs'] == 10 and cfg['iid'] is True and cfg['partition'] == 'iid'
    assert cfg['num_users'] == 200 and cfg['frac'] == 0.1
    assert cfg['evaluation_metrics'] == ['top1', 'macro_f1']
    print(f\"RESOLVED {name}: base model={cfg['model']} rounds={cfg['epochs']} partition={cfg['partition']} seed={cfg['seed']}\")

# HAM10000's fixed stratified 80/20 split has 8,012 train rows. Reproduce the
# shared ham10000_iid algorithm without importing torchvision or loading images.
def groups(seed):
    np.random.seed(seed)
    num_users, n = 200, 8012
    num_items = n // num_users
    result, remaining = {}, list(range(n))
    for i in range(num_users):
        result[i] = set(np.random.choice(remaining, num_items, replace=False))
        remaining = list(set(remaining) - result[i])
    return result
for seed in (20260714, 20260715, 20260716):
    hashes = [partition_hash(groups(seed)) for _ in paths]
    assert len(set(hashes)) == 1
    print(f\"PARTITION seed={seed} methods={len(hashes)} hash={hashes[0]}\")
PY
