import torch
from ehsfp.losses import prototype_replay_consistency_loss

model = torch.nn.Linear(3, 2, bias=False)
cur_p = {i: torch.full((3,), float(i + 1)) for i in range(100)}
mem_p = {i: torch.zeros(3) for i in range(100)}
std = {i: torch.zeros(3) for i in range(100)}
loss = prototype_replay_consistency_loss(cur_p, std, mem_p, std, model, num_samples=16)
loss.backward()
print({'loss': loss.item(), 'grad_norm': model.weight.grad.norm().item(), 'grad_nonzero': bool(model.weight.grad.abs().any())})
