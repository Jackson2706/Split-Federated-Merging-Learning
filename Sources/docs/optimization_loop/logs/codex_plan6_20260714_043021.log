    29	    def test_ssl_regression_returns_bitwise_identical_loss_tensor(self):
    30	        ssl_loss = torch.tensor(1.234567, requires_grad=True)
    31	        actual = compose_client_objective_loss(ssl_loss, "ssl")
    32	        self.assertIs(actual, ssl_loss)
    33	        self.assertTrue(torch.equal(actual, ssl_loss))
    34	        self.assertEqual(validate_client_objective(None), "ssl")
    35	
    36	    def test_ssl_client_step_is_bitwise_identical_to_legacy_formula(self):
    37	        torch.manual_seed(61)
    38	        legacy_model = nn.Conv2d(2, 3, kernel_size=1)
    39	        actual_model = nn.Conv2d(2, 3, kernel_size=1)
    40	        actual_model.load_state_dict(legacy_model.state_dict())
    41	        data = torch.randn(4, 2, 1, 1)
    42	        labels = torch.tensor([0, 0, 1, 1])
    43	
    44	        legacy_optimizer = torch.optim.Adam(legacy_model.parameters(), lr=1e-3)
    45	        legacy_optimizer.zero_grad(set_to_none=True)
    46	        z1, z2 = legacy_model(data), legacy_model(data)
    47	        z1 = torch.flatten(nn.AdaptiveAvgPool2d((1, 1))(z1), 1)
    48	        z2 = torch.flatten(nn.AdaptiveAvgPool2d((1, 1))(z2), 1)
    49	        legacy_loss = self.hierarchy.supervised_contrastive_loss(
    50	            torch.cat([z1, z2]), torch.cat([labels, labels]), temperature=0.1
    51	        )
    52	        legacy_loss.backward()
    53	        legacy_optimizer.step()
    54	
    55	        trainer = self.hierarchy.HierarchicalFL.__new__(self.hierarchy.HierarchicalFL)
    56	        trainer.device = torch.device("cpu")
    57	        trainer.structure = {-1: {0: actual_model}}
    58	        trainer.optimizers = {-1: {0: {
    59	            "optimizer": torch.optim.Adam(actual_model.parameters(), lr=1e-3),
    60	            "scaler": torch.amp.GradScaler(enabled=False),
    61	        }}}
    62	        trainer.ssl_transforms = nn.Identity()
    63	        trainer.supcon_temp = 0.1
    64	        trainer.client_objective = "ssl"
    65	        trainer.client_objective_weight = 0.1
    66	        trainer.client_supervised_heads = {}
    67	        trainer.client_supervised_optimizers = {}
    68	        loader = DataLoader(TensorDataset(data, labels), batch_size=4, shuffle=False)
    69	        trainer._client_ssl_extraction_phase(0, loader, ssl_epochs=1)
    70	
    71	        for key, expected in legacy_model.state_dict().items():
    72	            self.assertTrue(torch.equal(actual_model.state_dict()[key], expected), key)
