    18	class Plan6ClientObjectiveTests(unittest.TestCase):
    19	    @classmethod
    20	    def setUpClass(cls):
    21	        root = Path(__file__).resolve().parents[1]
    22	        spec = importlib.util.spec_from_file_location(
    23	            "classification_hsfp_hierarchy_plan6",
    24	            root / "classification/H-SFP/hierarchy.py",
