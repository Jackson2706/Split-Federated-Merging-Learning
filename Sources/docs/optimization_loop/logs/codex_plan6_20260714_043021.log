    74	    def test_ssl_supcon_is_finite_nonzero_and_reaches_encoder(self):
    75	        torch.manual_seed(6)
    76	        encoder = nn.Linear(5, 4)
    77	        features = encoder(torch.randn(6, 5))
    78	        labels = torch.tensor([0, 0, 1, 1, 2, 2])
    79	        auxiliary = local_supervised_contrastive_loss(features, labels)
    80	        self.assertTrue(torch.isfinite(auxiliary))
    81	        self.assertGreater(auxiliary.item(), 0)
    82	        auxiliary.backward()
    83	        self.assertGreater(encoder.weight.grad.norm().item(), 0)
    84	
    85	    def test_supervised_is_finite_nonzero_and_reaches_encoder(self):
    86	        torch.manual_seed(7)
    87	        encoder, head = nn.Linear(5, 4), nn.Linear(4, 3)
    88	        features = encoder(torch.randn(6, 5))
    89	        labels = torch.tensor([0, 1, 2, 0, 1, 2])
    90	        loss = compose_client_objective_loss(
    91	            features.sum() * 0, "supervised", features, labels,
    92	            linear_head=head, weight=0.1,
    93	        )
    94	        self.assertTrue(torch.isfinite(loss))
    95	        self.assertGreater(loss.item(), 0)
    96	        loss.backward()
    97	        self.assertGreater(encoder.weight.grad.norm().item(), 0)
