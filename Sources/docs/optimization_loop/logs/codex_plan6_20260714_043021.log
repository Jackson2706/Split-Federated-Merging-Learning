    51	def compose_client_objective_loss(
    52	    ssl_loss: torch.Tensor,
    53	    objective: str,
    54	    client_features: torch.Tensor | None = None,
    55	    client_labels: torch.Tensor | None = None,
    56	    linear_head: nn.Module | None = None,
    57	    weight: float = 0.1,
    58	    temperature: float = 0.1,
    59	) -> torch.Tensor:
    60	    """Add a client-local auxiliary term while preserving ``ssl`` by identity."""
    61	    objective = validate_client_objective(objective)
    62	    if objective == "ssl":
    63	        return ssl_loss
    64	    if client_features is None or client_labels is None:
    65	        raise ValueError(f"{objective} requires client-local features and labels")
    66	    if objective == "ssl_supcon":
    67	        auxiliary = local_supervised_contrastive_loss(
    68	            client_features, client_labels, temperature=temperature
    69	        )
    70	    else:
    71	        if linear_head is None:
    72	            raise ValueError("supervised requires a client-local linear head")
    73	        auxiliary = nn.functional.cross_entropy(linear_head(client_features), client_labels)
    74	    return ssl_loss + float(weight) * auxiliary
