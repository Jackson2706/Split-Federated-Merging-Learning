diff --git a/ehsfp/client_objective.py b/ehsfp/client_objective.py
new file mode 100644
index 0000000000000000000000000000000000000000..5fbfcf32763dad65fbefdc07c8c0c1f79cd2bd1d
--- /dev/null
+++ b/ehsfp/client_objective.py
@@ -0,0 +1,74 @@
+"""Client-local objective ablations for classification H-SFP.
+
+These helpers accept only client features and that client's labels. They have
+no access to edge/cloud tensors, prototypes, memory, or communication state.
+"""
+
+from __future__ import annotations
+
+import torch
+from torch import nn
+
+
+CLIENT_OBJECTIVES = ("ssl", "ssl_supcon", "supervised")
+
+
+def validate_client_objective(value: str | None) -> str:
+    objective = "ssl" if value is None else str(value)
+    if objective not in CLIENT_OBJECTIVES:
+        raise ValueError(
+            f"client_objective must be one of {CLIENT_OBJECTIVES}, got {objective!r}"
+        )
+    return objective
+
+
+def local_supervised_contrastive_loss(
+    features: torch.Tensor,
+    labels: torch.Tensor,
+    temperature: float = 0.1,
+) -> torch.Tensor:
+    """Supervised contrastive loss over one client's feature batch only."""
+    if features.ndim != 2:
+        raise ValueError(f"client features must be 2D, got {tuple(features.shape)}")
+    if labels.ndim != 1 or labels.shape[0] != features.shape[0]:
+        raise ValueError("client labels must be 1D and aligned with client features")
+
+    features = nn.functional.normalize(features, dim=1)
+    logits = features @ features.T / temperature
+    self_mask = torch.eye(features.shape[0], device=features.device, dtype=torch.bool)
+    positive_mask = labels[:, None].eq(labels[None, :]) & ~self_mask
+    logits = logits - logits.max(dim=1, keepdim=True).values.detach()
+    exp_logits = logits.exp().masked_fill(self_mask, 0)
+    log_prob = logits - (exp_logits.sum(dim=1, keepdim=True) + 1e-8).log()
+    positive_count = positive_mask.sum(dim=1)
+    valid = positive_count > 0
+    if not valid.any():
+        return features.sum() * 0.0
+    per_anchor = (log_prob * positive_mask).sum(dim=1) / positive_count.clamp_min(1)
+    return -per_anchor[valid].mean()
+
+
+def compose_client_objective_loss(
+    ssl_loss: torch.Tensor,
+    objective: str,
+    client_features: torch.Tensor | None = None,
+    client_labels: torch.Tensor | None = None,
+    linear_head: nn.Module | None = None,
+    weight: float = 0.1,
+    temperature: float = 0.1,
+) -> torch.Tensor:
+    """Add a client-local auxiliary term while preserving ``ssl`` by identity."""
+    objective = validate_client_objective(objective)
+    if objective == "ssl":
+        return ssl_loss
+    if client_features is None or client_labels is None:
+        raise ValueError(f"{objective} requires client-local features and labels")
+    if objective == "ssl_supcon":
+        auxiliary = local_supervised_contrastive_loss(
+            client_features, client_labels, temperature=temperature
+        )
+    else:
+        if linear_head is None:
+            raise ValueError("supervised requires a client-local linear head")
+        auxiliary = nn.functional.cross_entropy(linear_head(client_features), client_labels)
+    return ssl_loss + float(weight) * auxiliary
diff --git a/tests/test_plan6_client_objective.py b/tests/test_plan6_client_objective.py
new file mode 100644
index 0000000000000000000000000000000000000000..7d17aea2204b261b0447dc13625f1b5842286f0d
--- /dev/null
+++ b/tests/test_plan6_client_objective.py
@@ -0,0 +1,112 @@
+import inspect
+import importlib.util
+from pathlib import Path
+import unittest
+
+import torch
+from torch import nn
+from torch.utils.data import DataLoader, TensorDataset
+
+from ehsfp.client_objective import (
+    compose_client_objective_loss,
+    local_supervised_contrastive_loss,
+    validate_client_objective,
+)
+
+
+class Plan6ClientObjectiveTests(unittest.TestCase):
+    @classmethod
+    def setUpClass(cls):
+        root = Path(__file__).resolve().parents[1]
+        spec = importlib.util.spec_from_file_location(
+            "classification_hsfp_hierarchy_plan6",
+            root / "classification/H-SFP/hierarchy.py",
+        )
+        cls.hierarchy = importlib.util.module_from_spec(spec)
+        spec.loader.exec_module(cls.hierarchy)
+
+    def test_ssl_regression_returns_bitwise_identical_loss_tensor(self):
+        ssl_loss = torch.tensor(1.234567, requires_grad=True)
+        actual = compose_client_objective_loss(ssl_loss, "ssl")
+        self.assertIs(actual, ssl_loss)
+        self.assertTrue(torch.equal(actual, ssl_loss))
+        self.assertEqual(validate_client_objective(None), "ssl")
+
+    def test_ssl_client_step_is_bitwise_identical_to_legacy_formula(self):
+        torch.manual_seed(61)
+        legacy_model = nn.Conv2d(2, 3, kernel_size=1)
+        actual_model = nn.Conv2d(2, 3, kernel_size=1)
+        actual_model.load_state_dict(legacy_model.state_dict())
+        data = torch.randn(4, 2, 1, 1)
+        labels = torch.tensor([0, 0, 1, 1])
+
+        legacy_optimizer = torch.optim.Adam(legacy_model.parameters(), lr=1e-3)
+        legacy_optimizer.zero_grad(set_to_none=True)
+        z1, z2 = legacy_model(data), legacy_model(data)
+        z1 = torch.flatten(nn.AdaptiveAvgPool2d((1, 1))(z1), 1)
+        z2 = torch.flatten(nn.AdaptiveAvgPool2d((1, 1))(z2), 1)
+        legacy_loss = self.hierarchy.supervised_contrastive_loss(
+            torch.cat([z1, z2]), torch.cat([labels, labels]), temperature=0.1
+        )
+        legacy_loss.backward()
+        legacy_optimizer.step()
+
+        trainer = self.hierarchy.HierarchicalFL.__new__(self.hierarchy.HierarchicalFL)
+        trainer.device = torch.device("cpu")
+        trainer.structure = {-1: {0: actual_model}}
+        trainer.optimizers = {-1: {0: {
+            "optimizer": torch.optim.Adam(actual_model.parameters(), lr=1e-3),
+            "scaler": torch.amp.GradScaler(enabled=False),
+        }}}
+        trainer.ssl_transforms = nn.Identity()
+        trainer.supcon_temp = 0.1
+        trainer.client_objective = "ssl"
+        trainer.client_objective_weight = 0.1
+        trainer.client_supervised_heads = {}
+        trainer.client_supervised_optimizers = {}
+        loader = DataLoader(TensorDataset(data, labels), batch_size=4, shuffle=False)
+        trainer._client_ssl_extraction_phase(0, loader, ssl_epochs=1)
+
+        for key, expected in legacy_model.state_dict().items():
+            self.assertTrue(torch.equal(actual_model.state_dict()[key], expected), key)
+
+    def test_ssl_supcon_is_finite_nonzero_and_reaches_encoder(self):
+        torch.manual_seed(6)
+        encoder = nn.Linear(5, 4)
+        features = encoder(torch.randn(6, 5))
+        labels = torch.tensor([0, 0, 1, 1, 2, 2])
+        auxiliary = local_supervised_contrastive_loss(features, labels)
+        self.assertTrue(torch.isfinite(auxiliary))
+        self.assertGreater(auxiliary.item(), 0)
+        auxiliary.backward()
+        self.assertGreater(encoder.weight.grad.norm().item(), 0)
+
+    def test_supervised_is_finite_nonzero_and_reaches_encoder(self):
+        torch.manual_seed(7)
+        encoder, head = nn.Linear(5, 4), nn.Linear(4, 3)
+        features = encoder(torch.randn(6, 5))
+        labels = torch.tensor([0, 1, 2, 0, 1, 2])
+        loss = compose_client_objective_loss(
+            features.sum() * 0, "supervised", features, labels,
+            linear_head=head, weight=0.1,
+        )
+        self.assertTrue(torch.isfinite(loss))
+        self.assertGreater(loss.item(), 0)
+        loss.backward()
+        self.assertGreater(encoder.weight.grad.norm().item(), 0)
+
+    def test_auxiliary_api_has_no_cross_tier_inputs(self):
+        for function in (local_supervised_contrastive_loss, compose_client_objective_loss):
+            parameters = set(inspect.signature(function).parameters)
+            self.assertFalse(parameters & {
+                "edge_features", "cloud_features", "edge_outputs", "prototypes",
+                "memory", "client_outputs",
+            })
+
+    def test_invalid_objective_is_rejected(self):
+        with self.assertRaises(ValueError):
+            validate_client_objective("cross_tier")
+
+
+if __name__ == "__main__":
+    unittest.main()
diff --git a/tools/diag/encoder_linear_probe.py b/tools/diag/encoder_linear_probe.py
new file mode 100644
index 0000000000000000000000000000000000000000..c280faa3636898f94daac7fac0290a3c03a96b84
--- /dev/null
+++ b/tools/diag/encoder_linear_probe.py
@@ -0,0 +1,88 @@
+#!/usr/bin/env python3
+"""Measure client-encoder linear-probe top-1 on real H-SFP features.
+
+Diagnostic only: real activations are materialized offline and are never part
+of H-SFP training or communication.
+"""
+
+from __future__ import annotations
+
+import argparse
+import json
+from pathlib import Path
+
+import torch
+
+import oracle_probe as oracle
+
+
+def parse_args():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--config", type=Path, required=True)
+    parser.add_argument("--checkpoint", type=Path, required=True)
+    parser.add_argument("--output-dir", type=Path, required=True)
+    parser.add_argument("--seed", type=int, default=20260714)
+    parser.add_argument("--device", choices=("auto", "cpu", "cuda"), default="auto")
+    parser.add_argument("--batch-size", type=int, default=256)
+    parser.add_argument("--workers", type=int, default=2)
+    parser.add_argument("--linear-epochs", type=int, default=10)
+    parser.add_argument("--linear-lr", type=float, default=1e-3)
+    return parser.parse_args()
+
+
+def main():
+    args = parse_args()
+    args.config = args.config.resolve()
+    args.checkpoint = args.checkpoint.resolve()
+    args.output_dir = args.output_dir.resolve()
+    result_path = args.output_dir / "encoder_linear_probe.json"
+    if result_path.exists():
+        raise FileExistsError(f"refusing to overwrite existing diagnostic: {result_path}")
+    args.output_dir.mkdir(parents=True, exist_ok=True)
+
+    oracle.seed_everything(args.seed)
+    device = oracle.resolve_device(args.device)
+    config = oracle.ConfigLoader(str(args.config)).get_config()
+    config["seed"] = args.seed
+    config["is_gpu"] = device.type == "cuda"
+    client, _edge, _cloud, checkpoint_meta = oracle.load_models(
+        config, args.checkpoint, device
+    )
+    train_dataset, eval_dataset, _test_dataset, _user_groups = oracle.get_dataset(config)
+    identity_edge = torch.nn.Identity()
+    train = oracle.extract_features(
+        train_dataset, client, identity_edge, device, args.batch_size, args.workers
+    )
+    evaluate = oracle.extract_features(
+        eval_dataset, client, identity_edge, device, args.batch_size, args.workers
+    )
+    train_x, train_y = train["L1_client_post_gap"], train["labels"]
+    eval_x, eval_y = evaluate["L1_client_post_gap"], evaluate["labels"]
+    mean = train_x.mean(0)
+    std = train_x.std(0, unbiased=False).clamp_min(1e-6)
+    probe = oracle.StandardizedLinear(
+        train_x.shape[1], int(config["num_classes"]), mean, std
+    )
+    top1 = oracle.train_and_evaluate(
+        probe, train_x, train_y, eval_x, eval_y, device,
+        args.linear_epochs, args.batch_size, args.linear_lr, args.seed,
+    )
+    result = {
+        "diagnostic_only": True,
+        "violates_no_activation_constraint": True,
+        "boundary": "L1_client_post_gap",
+        "client_encoder_linear_probe_top1": top1,
+        "train_samples": int(train_y.numel()),
+        "eval_samples": int(eval_y.numel()),
+        "seed": args.seed,
+        "device": str(device),
+        "config": str(args.config),
+        "checkpoint": checkpoint_meta,
+    }
+    result_path.write_text(json.dumps(result, indent=2, sort_keys=True) + "\n")
+    print(f"client_encoder_linear_probe_top1={top1:.6f}")
+    print(f"wrote {result_path}")
+
+
+if __name__ == "__main__":
+    main()

