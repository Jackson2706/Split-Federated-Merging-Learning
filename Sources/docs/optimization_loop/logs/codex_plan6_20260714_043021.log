    10	import argparse
    11	import json
    12	from pathlib import Path
    13	
    14	import torch
    15	
    16	import oracle_probe as oracle
    17	
    18	
    19	def parse_args():
    20	    parser = argparse.ArgumentParser(description=__doc__)
    21	    parser.add_argument("--config", type=Path, required=True)
    22	    parser.add_argument("--checkpoint", type=Path, required=True)
    23	    parser.add_argument("--output-dir", type=Path, required=True)
    24	    parser.add_argument("--seed", type=int, default=20260714)
    25	    parser.add_argument("--device", choices=("auto", "cpu", "cuda"), default="auto")
    26	    parser.add_argument("--batch-size", type=int, default=256)
    27	    parser.add_argument("--workers", type=int, default=2)
    28	    parser.add_argument("--linear-epochs", type=int, default=10)
    29	    parser.add_argument("--linear-lr", type=float, default=1e-3)
    30	    return parser.parse_args()
    31	
    32	
    33	def main():
    34	    args = parse_args()
    35	    args.config = args.config.resolve()
    36	    args.checkpoint = args.checkpoint.resolve()
    37	    args.output_dir = args.output_dir.resolve()
    38	    result_path = args.output_dir / "encoder_linear_probe.json"
    39	    if result_path.exists():
    40	        raise FileExistsError(f"refusing to overwrite existing diagnostic: {result_path}")
    41	    args.output_dir.mkdir(parents=True, exist_ok=True)
    42	
    43	    oracle.seed_everything(args.seed)
    44	    device = oracle.resolve_device(args.device)
    45	    config = oracle.ConfigLoader(str(args.config)).get_config()
    46	    config["seed"] = args.seed
    47	    config["is_gpu"] = device.type == "cuda"
    48	    client, _edge, _cloud, checkpoint_meta = oracle.load_models(
    49	        config, args.checkpoint, device
    50	    )
    51	    train_dataset, eval_dataset, _test_dataset, _user_groups = oracle.get_dataset(config)
    52	    identity_edge = torch.nn.Identity()
    53	    train = oracle.extract_features(
    54	        train_dataset, client, identity_edge, device, args.batch_size, args.workers
    55	    )
    56	    evaluate = oracle.extract_features(
    57	        eval_dataset, client, identity_edge, device, args.batch_size, args.workers
    58	    )
    59	    train_x, train_y = train["L1_client_post_gap"], train["labels"]
    60	    eval_x, eval_y = evaluate["L1_client_post_gap"], evaluate["labels"]
    61	    mean = train_x.mean(0)
    62	    std = train_x.std(0, unbiased=False).clamp_min(1e-6)
    63	    probe = oracle.StandardizedLinear(
    64	        train_x.shape[1], int(config["num_classes"]), mean, std
    65	    )
    66	    top1 = oracle.train_and_evaluate(
    67	        probe, train_x, train_y, eval_x, eval_y, device,
    68	        args.linear_epochs, args.batch_size, args.linear_lr, args.seed,
    69	    )
    70	    result = {
    71	        "diagnostic_only": True,
    72	        "violates_no_activation_constraint": True,
    73	        "boundary": "L1_client_post_gap",
    74	        "client_encoder_linear_probe_top1": top1,
    75	        "train_samples": int(train_y.numel()),
    76	        "eval_samples": int(eval_y.numel()),
    77	        "seed": args.seed,
    78	        "device": str(device),
    79	        "config": str(args.config),
    80	        "checkpoint": checkpoint_meta,
    81	    }
    82	    result_path.write_text(json.dumps(result, indent=2, sort_keys=True) + "\n")
    83	    print(f"client_encoder_linear_probe_top1={top1:.6f}")
    84	    print(f"wrote {result_path}")
    85	
