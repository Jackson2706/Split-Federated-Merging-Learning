    16	def validate_client_objective(value: str | None) -> str:
    17	    objective = "ssl" if value is None else str(value)
    18	    if objective not in CLIENT_OBJECTIVES:
    19	        raise ValueError(
    20	            f"client_objective must be one of {CLIENT_OBJECTIVES}, got {objective!r}"
    21	        )
    22	    return objective
