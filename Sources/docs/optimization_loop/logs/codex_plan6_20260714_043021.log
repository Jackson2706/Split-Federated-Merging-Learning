    25	def local_supervised_contrastive_loss(
    26	    features: torch.Tensor,
    27	    labels: torch.Tensor,
    28	    temperature: float = 0.1,
    29	) -> torch.Tensor:
    30	    """Supervised contrastive loss over one client's feature batch only."""
    31	    if features.ndim != 2:
    32	        raise ValueError(f"client features must be 2D, got {tuple(features.shape)}")
    33	    if labels.ndim != 1 or labels.shape[0] != features.shape[0]:
    34	        raise ValueError("client labels must be 1D and aligned with client features")
    35	
    36	    features = nn.functional.normalize(features, dim=1)
    37	    logits = features @ features.T / temperature
    38	    self_mask = torch.eye(features.shape[0], device=features.device, dtype=torch.bool)
    39	    positive_mask = labels[:, None].eq(labels[None, :]) & ~self_mask
    40	    logits = logits - logits.max(dim=1, keepdim=True).values.detach()
    41	    exp_logits = logits.exp().masked_fill(self_mask, 0)
    42	    log_prob = logits - (exp_logits.sum(dim=1, keepdim=True) + 1e-8).log()
    43	    positive_count = positive_mask.sum(dim=1)
    44	    valid = positive_count > 0
    45	    if not valid.any():
    46	        return features.sum() * 0.0
    47	    per_anchor = (log_prob * positive_mask).sum(dim=1) / positive_count.clamp_min(1)
    48	    return -per_anchor[valid].mean()
    49	
