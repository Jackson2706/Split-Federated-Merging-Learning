    49	def extract_narrow_model(wide_model, narrow_channels):
    50	    narrow_state = copy.deepcopy(wide_model.state_dict())
    51	    keys = list(narrow_state.keys())
    52	    # bl_encoder weight and bias are the last two keys of the client model
    53	    narrow_state[keys[-2]] = narrow_state[keys[-2]][:narrow_channels]
    54	    narrow_state[keys[-1]] = narrow_state[keys[-1]][:narrow_channels]
    55	    return narrow_state
