    module = importlib.import_module(\"clients.test\")
    probabilities = torch.tensor([0.9, 0.6, 0.4, 0.1])
    labels = torch.tensor([1.0, 0.0, 1.0, 0.0])
    actual = module.compute_iou_and_dice(probabilities, labels)
