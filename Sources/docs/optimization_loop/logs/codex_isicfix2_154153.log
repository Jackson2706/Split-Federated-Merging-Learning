/bin/bash -lc "python - <<'PY'
import importlib
import os
import sys

import torch

root = os.getcwd()
expected = (0.5, 2.0 / 3.0)
for method in (\"Federated\", \"HierFL\", \"HeteroSFL\", \"H-SFP\"):
    method_dir = os.path.join(root, \"segmentation\", method)
    sys.path.insert(0, method_dir)
    module = importlib.import_module(\"clients.test\")
    probabilities = torch.tensor([0.9, 0.6, 0.4, 0.1])
    labels = torch.tensor([1.0, 0.0, 1.0, 0.0])
    actual = module.compute_iou_and_dice(probabilities, labels)
    assert all(abs(a - e) < 1e-8 for a, e in zip(actual, expected)), (method, actual)
    print(f\"{method}: IoU={actual[0]:.6f}, Dice={actual[1]:.6f}\")
    sys.path.pop(0)
    for name in list(sys.modules):
        if name == \"clients\" or name.startswith(\"clients.\"):
            del sys.modules[name]

import main
method_dir = os.path.join(root, \"segmentation\", \"HeteroSFL\")
runner = main._load_runner(method_dir)
assert callable(runner.run)
main._cleanup_runner(method_dir)
print(\"HeteroSFL runner import: OK\")

from pathlib import Path
import yaml
proxy = Path(\"configs/proxy/plan_isic2018_h-sfp.yaml\")
config = yaml.safe_load(proxy.read_text())
base = (proxy.parent / config[\"base\"]).resolve()
assert base.is_file(), base
print(f\"H-SFP proxy base: OK ({base.relative_to(Path.cwd())})\")
