    57	
    58	def aggregate_hetero(global_wide_weights, local_updates, narrow_channels):
    59	    update_acc = {k: torch.zeros_like(v) for k, v in global_wide_weights.items()}
    60	    count_acc = {k: torch.zeros_like(v) for k, v in global_wide_weights.items()}
    61	    keys = list(global_wide_weights.keys())
    62	    weight_key, bias_key = keys[-2], keys[-1]
    63	
    64	    for local_w in local_updates:
    65	        is_narrow = local_w[weight_key].shape[0] == narrow_channels
    66	        for k in local_w:
    67	            if k in [weight_key, bias_key] and is_narrow:
    68	                update_acc[k][:narrow_channels] += local_w[k]
    69	                count_acc[k][:narrow_channels] += 1
    70	            else:
    71	                update_acc[k] += local_w[k]
    72	                count_acc[k] += 1
    73	
    74	    avg_weights = copy.deepcopy(global_wide_weights)
    75	    for k in avg_weights:
    76	        mask = count_acc[k] > 0
    77	        avg_weights[k][mask] = update_acc[k][mask] / count_acc[k][mask]
    78	    return avg_weights
