# ---- Python ----
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
build/
dist/
.ipynb_checkpoints/

# ---- Virtual environments ----
.venv/
venv/
env/
ENV/

# ---- Editors / OS ----
.idea/
.vscode/
.DS_Store
*.swp

# ---- Claude / local tooling ----
/.claude/

# ---- Datasets (never commit data) ----
/data/
/dataset/
/datasets/

# ---- Model checkpoints / weights ----
*.pt
*.pth
*.ckpt
checkpoint*.pt

# ---- Logs & run artifacts ----
/logs/
*.log
*.out
nohup.out
/wandb/
events.out.tfevents.*

# ---- Auto-generated temporary configs (main.py --set / --ablation / --seed) ----
**/exp_*.yaml

# ---- Generated experiment outputs (track only README docs; everything else regenerable) ----
/results/**
!/results/**/
!/results/**/README.md

# ---- Generated figures (plotting scripts live in tools/) ----
/Figure/*.png
/Figure/*.pdf
/Figure/**/*.png
/Figure/**/*.pdf
